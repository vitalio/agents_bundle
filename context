def _normalize_exclude_path(raw: str) -> str:
    s = Path(raw.strip()).as_posix().strip("/")
    while s.startswith("./"):
        s = s[2:].strip("/")
    return s


def _is_under_excluded(rel_posix: str, excluded_set: set[str]) -> str | None:
    for ex in excluded_set:
        if rel_posix == ex or rel_posix.startswith(ex + "/"):
            return ex
    return None


def _collect_repo_files(root: Path, excluded_set: set[str]) -> tuple[list[str], set[str]]:
    found_excluded: set[str] = set()
    for ex in excluded_set:
        if (root / ex).is_dir():
            found_excluded.add(ex)

    try:
        r = subprocess.run(
            ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False,
        )
        if r.returncode == 0:
            files = []
            for raw in r.stdout.splitlines():
                rel = raw.strip()
                if not rel:
                    continue
                rel_posix = Path(rel).as_posix()
                matched_ex = _is_under_excluded(rel_posix, excluded_set)
                if matched_ex is not None:
                    found_excluded.add(matched_ex)
                    continue
                p = root / rel_posix
                if p.is_file() and not p.is_symlink():
                    files.append(rel_posix)
            return sorted(set(files)), found_excluded
    except Exception:
        pass

    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir_obj = Path(dirpath).relative_to(root)
        rel_dir_str = "" if str(rel_dir_obj) == "." else rel_dir_obj.as_posix()
        kept_dirs: list[str] = []
        for d in sorted(dirnames):
            if d in _TREE_SKIP_DIRS or d.startswith(".git"):
                continue
            cand_rel = f"{rel_dir_str}/{d}" if rel_dir_str else d
            if cand_rel in excluded_set:
                found_excluded.add(cand_rel)
                continue
            kept_dirs.append(d)
        dirnames[:] = kept_dirs
        for fn in sorted(filenames):
            p = Path(dirpath) / fn
            if p.is_file() and not p.is_symlink():
                rel_p = f"{rel_dir_str}/{fn}" if rel_dir_str else fn
                files.append(rel_p)
    return sorted(set(files)), found_excluded


_LARGE_FILE_BYTES = 16 * 1024
_DENSE_LINE_BYTES = 120


def _format_total_size(num_bytes: int) -> str:
    if num_bytes < 1024:
        return f"{num_bytes} B"
    if num_bytes < 1024 * 1024:
        val = f"{num_bytes / 1024:.1f}"
        if val.endswith(".0"):
            val = val[:-2]
        return f"{val} KB"
    val = f"{num_bytes / (1024 * 1024):.1f}"
    if val.endswith(".0"):
        val = val[:-2]
    return f"{val} MB"


def _format_file_size_k(num_bytes: int) -> str:
    kb = num_bytes / 1024
    if kb >= 10:
        return f"{round(kb)}K"
    val = f"{max(0.1, kb):.1f}"
    if val.endswith(".0"):
        val = val[:-2]
    return f"{val}K"


def _format_file_tag(lines_n: int, is_bin: bool, size: int) -> str:
    if is_bin:
        return f"({size:,}B)"
    if size >= _LARGE_FILE_BYTES or (lines_n > 0 and size > lines_n * _DENSE_LINE_BYTES):
        return f"({lines_n}L, {_format_file_size_k(size)})"
    return f"({lines_n}L)"


def _inspect_file_meta(path: Path) -> tuple[int, bool, int]:
    try:
        size = path.stat().st_size
        with path.open("rb") as f:
            head = f.read(4096)
            if b"\x00" in head:
                return 0, True, size
            rest = f.read(512 * 1024)
        data = head + rest
        n_lines = data.count(b"\n") + (1 if data and not data.endswith(b"\n") else 0)
        return n_lines, False, size
    except OSError:
        return 0, False, 0


def build_repo_tree(
    root_dir: Path | None = None,
    max_lines: int = 160,
    max_tokens: int = 1600,
    exclude_dirs: list[str] | None = None,
) -> str:
    root = (root_dir if root_dir is not None else Path.cwd()).resolve()
    excluded_input = {
        _normalize_exclude_path(x)
        for x in (exclude_dirs or [])
        if _normalize_exclude_path(x)
    }
    rel_files, active_excluded = _collect_repo_files(root, excluded_input)
    file_info: dict[str, tuple[int, bool, int]] = {}
    dir_files: dict[str, list[str]] = {"": []}
    dir_subdirs: dict[str, list[str]] = {"": []}
    all_dirs: set[str] = {""}

    def ensure_dir_chain(dir_path: str) -> None:
        if not dir_path:
            return
        parts = dir_path.split("/")
        cur = ""
        for part in parts:
            nxt = f"{cur}/{part}" if cur else part
            if nxt not in all_dirs:
                all_dirs.add(nxt)
                dir_files[nxt] = []
                dir_subdirs[nxt] = []
                dir_subdirs[cur].append(nxt)
            cur = nxt

    for ex_dir in sorted(active_excluded):
        ensure_dir_chain(ex_dir)

    for rel in rel_files:
        info = _inspect_file_meta(root / rel)
        file_info[rel] = info
        parts = rel.split("/")
        parent_dir = "/".join(parts[:-1])
        ensure_dir_chain(parent_dir)
        dir_files[parent_dir].append(rel)

    dirs_with_agents: set[str] = set()
    for d in all_dirs:
        dir_subdirs[d].sort()
        dir_files[d].sort(key=lambda f: (0 if f.rsplit("/", 1)[-1] == "AGENTS.md" else 1, f))
        if any(f.rsplit("/", 1)[-1] == "AGENTS.md" for f in dir_files[d]):
            cur_a = d
            while True:
                dirs_with_agents.add(cur_a)
                if not cur_a or "/" not in cur_a:
                    if cur_a:
                        dirs_with_agents.add("")
                    break
                cur_a = cur_a.rsplit("/", 1)[0]

    dirs_bottom_up = sorted(all_dirs, key=lambda x: (0 if not x else x.count("/") + 1), reverse=True)
    dir_totals: dict[str, tuple[int, int, int]] = {}
    for d in dirs_bottom_up:
        if d in active_excluded:
            dir_totals[d] = (0, 0, 0)
            continue
        f_cnt = len(dir_files[d])
        l_cnt = sum(file_info[f][0] for f in dir_files[d])
        b_cnt = sum(file_info[f][2] for f in dir_files[d])
        for sub in dir_subdirs[d]:
            sf, sl, sb = dir_totals[sub]
            f_cnt += sf
            l_cnt += sl
            b_cnt += sb
        dir_totals[d] = (f_cnt, l_cnt, b_cnt)

    def render_dir(
        d: str,
        prefix: str,
        collapsed: set[str],
        file_limits: dict[str, int],
    ) -> list[str]:
        out: list[str] = []
        subs = dir_subdirs[d]
        files = dir_files[d]
        limit = file_limits.get(d)
        extra_files = 0
        extra_lines = 0
        if limit is not None and len(files) > limit:
            hidden = files[limit:]
            extra_files = len(hidden)
            extra_lines = sum(file_info[f][0] for f in hidden)
            files = files[:limit]

        entries: list[tuple[str, str]] = [("dir", s) for s in subs] + [("file", f) for f in files]
        if extra_files > 0:
            entries.append(("more", f"... (+{extra_files} more file{'s' if extra_files != 1 else ''}, {extra_lines:,}L)"))

        for idx, (kind, item) in enumerate(entries):
            is_last = idx == len(entries) - 1
            conn = "└── " if is_last else "├── "
            child_prefix = prefix + ("    " if is_last else "│   ")
            if kind == "dir":
                name = item.rsplit("/", 1)[-1]
                if item in active_excluded:
                    out.append(f"{prefix}{conn}{name}/ (excluded)")
                elif item in collapsed:
                    fc, lc, _ = dir_totals[item]
                    ag_note = ", AGENTS.md" if item in dirs_with_agents else ""
                    out.append(f"{prefix}{conn}{name}/ ({fc} file{'s' if fc != 1 else ''}, {lc:,}L{ag_note})")
                else:
                    out.append(f"{prefix}{conn}{name}/")
                    out.extend(render_dir(item, child_prefix, collapsed, file_limits))
            elif kind == "file":
                name = item.rsplit("/", 1)[-1]
                lines_n, is_bin, sz = file_info[item]
                tag = _format_file_tag(lines_n, is_bin, sz)
                out.append(f"{prefix}{conn}{name} {tag}")
            else:
                out.append(f"{prefix}{conn}{item}")
        return out

    collapsed: set[str] = set()
    file_limits: dict[str, int] = {}
    total_f, total_l, total_b = dir_totals[""]
    footer = (
        f"# Total: {total_f} file{'s' if total_f != 1 else ''}, "
        f"{total_l:,} lines ({_format_total_size(total_b)})"
    )

    def is_visible_dir(d: str) -> bool:
        if d == "" or d in active_excluded or d in collapsed:
            return False
        cur = d
        while "/" in cur:
            cur = cur.rsplit("/", 1)[0]
            if cur in collapsed or cur in active_excluded:
                return False
        return True

    while True:
        body = [f"{root.name}/"] + render_dir("", "", collapsed, file_limits)
        full_lines = body + [footer]
        tok = approx_tokens("\n".join(full_lines))
        if len(full_lines) <= max_lines and tok <= max_tokens:
            return "\n".join(full_lines) + "\n"

        # Stage 1: collapse nested subdirectories (depth >= 1) first, deepest first.
        # Include single-file deep chains when they have subdirectories or files inside.
        deep_candidates = [
            d for d in all_dirs
            if "/" in d and is_visible_dir(d) and (len(dir_subdirs[d]) + len(dir_files[d]) > 0)
        ]
        if deep_candidates:
            best_deep = max(deep_candidates, key=lambda d: (0 if d in dirs_with_agents else 1, d.count("/"), dir_totals[d][0]))
            collapsed.add(best_deep)
            # Clean up any child collapses under best_deep so set stays small
            prefix_slash = best_deep + "/"
            collapsed = {c for c in collapsed if not c.startswith(prefix_slash)}
            continue

        # Stage 2: truncate file lists in visible directories (down to 8, then 5) before collapsing top-level dirs
        trunc_candidates = []
        for d in all_dirs:
            if d != "" and not is_visible_dir(d):
                continue
            cur_lim = file_limits.get(d, len(dir_files[d]))
            if len(dir_files[d]) > 6 and cur_lim > 5:
                trunc_candidates.append((cur_lim, len(dir_files[d]), d))
        if trunc_candidates:
            _, _, best_trunc = max(trunc_candidates)
            cur_lim = file_limits.get(best_trunc, len(dir_files[best_trunc]))
            file_limits[best_trunc] = 8 if cur_lim > 10 else 5
            continue

        # Stage 3: collapse top-level directories if still over budget
        top_candidates = [
            d for d in dir_subdirs[""]
            if is_visible_dir(d) and (len(dir_subdirs[d]) + len(dir_files[d]) > 0)
        ]
        if top_candidates:
            best_top = max(top_candidates, key=lambda d: (0 if d in dirs_with_agents else 1, dir_totals[d][0]))
            collapsed.add(best_top)
            continue

        return "\n".join(full_lines[: max(2, max_lines - 1)] + [footer]) + "\n"


def _tree_from_args(argv: list[str], default_dir: Path | None = None) -> str:
    prog = prog_name()
    max_lines = 160
    max_tokens = 1600
    exclude_dirs: list[str] = []
    target_dir: Path | None = default_dir
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--max-lines":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --max-lines requires an integer")
            try:
                max_lines = max(5, int(argv[i + 1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-lines value: {argv[i + 1]!r}")
            i += 2
        elif a.startswith("--max-lines="):
            try:
                max_lines = max(5, int(a.split("=", 1)[1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-lines value: {a!r}")
            i += 1
        elif a == "--max-tokens":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --max-tokens requires an integer")
            try:
                max_tokens = max(20, int(argv[i + 1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-tokens value: {argv[i + 1]!r}")
            i += 2
        elif a.startswith("--max-tokens="):
            try:
                max_tokens = max(20, int(a.split("=", 1)[1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-tokens value: {a!r}")
            i += 1
        elif a in ("-x", "--exclude"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires a directory name")
            for part in argv[i + 1].split(","):
                if part.strip():
                    exclude_dirs.append(part.strip())
            i += 2
        elif a.startswith("--exclude="):
            for part in a.split("=", 1)[1].split(","):
                if part.strip():
                    exclude_dirs.append(part.strip())
            i += 1
        elif a.startswith("-"):
            raise SystemExit(
                f"{prog}: usage: {prog} --tree [DIR] [-x/--exclude DIR] [--max-lines N] [--max-tokens N]"
            )
        else:
            p = Path(a).expanduser()
            if default_dir is not None and not p.is_absolute():
                p = default_dir / p
            if not p.is_dir():
                raise SystemExit(f"{prog}: directory not found: {a}")
            target_dir = p
            i += 1
    return build_repo_tree(
        root_dir=target_dir,
        max_lines=max_lines,
        max_tokens=max_tokens,
        exclude_dirs=exclude_dirs,
    )


def cmd_tree(argv: list[str]) -> int:
    sys.stdout.write(_tree_from_args(argv))
    return 0


VAR_NAME_RE = re.compile(VAR_NAME_PATTERN)
RULE_VAR_RE = re.compile(rf"\{{({VAR_NAME_PATTERN}):([^{{}}]*)\}}")


def _render_rule_vars(text: str, vars_map: dict[str, str]) -> str:
    return RULE_VAR_RE.sub(lambda m: vars_map.get(m.group(1), m.group(2)), text)


def _detect_os_name() -> str:
    if sys.platform == "darwin":
        return "macos"
    return "linux"


def _detect_vcs_name(work_dir: Path | None = None) -> str:
    wdir = (work_dir if work_dir is not None else Path.cwd()).resolve()
    cur = wdir
    while True:
        if (cur / ".git").exists():
            return "git"
        if (cur / "CVS").is_dir():
            return "cvs"
        if cur.parent == cur:
            break
        cur = cur.parent
    return ""


def builtin_vars(work_dir: Path | None = None, piped: bool = False) -> dict[str, str]:
    return {
        "os": _detect_os_name(),
        "vcs": _detect_vcs_name(work_dir),
        "piped": "1" if piped else "",
    }


def env_vars(prog: str | None = None) -> dict[str, str]:
    raw = os.environ.get("CONTEXT_BUNDLE_VARS", "").strip()
    if not raw:
        return {}
    p = prog or prog_name()
    try:
        tokens = shlex.split(raw)
    except ValueError as exc:
        raise SystemExit(f"{p}: invalid CONTEXT_BUNDLE_VARS={raw!r}: {exc}")
    out: dict[str, str] = {}
    for tok in tokens:
        if "=" not in tok:
            raise SystemExit(f"{p}: invalid entry {tok!r} in CONTEXT_BUNDLE_VARS (expected key=val)")
        k, v = tok.split("=", 1)
        k_clean = k.strip()
        if not VAR_NAME_RE.fullmatch(k_clean):
            raise SystemExit(f"{p}: invalid variable name {k_clean!r} in CONTEXT_BUNDLE_VARS")
        out[k_clean] = v.strip()
    return out


def _validate_if_condition_tokens(cond_expr: str, prog: str) -> list[tuple[str, str, set[str]]]:
    s = cond_expr.strip()
    if s.endswith(":"):
        raise SystemExit(f"{prog}: trailing ':' is not allowed in condition {cond_expr!r}")
    try:
        tokens = shlex.split(s)
    except ValueError as exc:
        raise SystemExit(f"{prog}: invalid condition {cond_expr!r}: {exc}")
    if not tokens:
        raise SystemExit(f"{prog}: empty if condition")
    parsed: list[tuple[str, str, set[str]]] = []
    for tok in tokens:
        if "!=" in tok:
            k, expected = tok.split("!=", 1)
            op = "!="
        elif "=" in tok:
            k, expected = tok.split("=", 1)
            op = "="
        else:
            raise SystemExit(
                f"{prog}: invalid condition token {tok!r} in 'if {cond_expr}' (expected key=val or key!=val)"
            )
        k_clean = k.strip()
        if not VAR_NAME_RE.fullmatch(k_clean):
            raise SystemExit(f"{prog}: invalid variable name {k_clean!r} in condition {cond_expr!r}")
        allowed = {v.strip() for v in expected.split(",")}
        parsed.append((op, k_clean, allowed))
    return parsed


def eval_if_condition(cond_expr: str, vars_map: dict[str, str], prog: str | None = None) -> bool:
    p = prog or prog_name()
    for op, k, allowed in _validate_if_condition_tokens(cond_expr, p):
        actual = vars_map.get(k, "")
        if op == "!=":
            if actual in allowed:
                return False
        else:
            if actual not in allowed:
                return False
    return True


def _preprocess_bundle_lines(raw_text: str, prog: str) -> list[tuple[int, str]]:
    """Extract non-empty, non-comment lines with validated 4-space indentation."""
    lines_out: list[tuple[int, str]] = []
    for raw_line in raw_text.splitlines():
        stripped = raw_line.strip()
        if not stripped or stripped.startswith("#"):
            continue
        leading = raw_line[: len(raw_line) - len(raw_line.lstrip())]
        if "\t" in leading:
            raise SystemExit(f"{prog}: tabs are not allowed in indentation: {raw_line!r}")
        raw_indent = len(leading)
        if raw_indent % 4 != 0:
            raise SystemExit(f"{prog}: indentation must be a multiple of 4 spaces: {raw_line!r}")
        if stripped.lower() == "endif":
            raise SystemExit(f"{prog}: 'endif' is not supported; use 4-space indented blocks: {raw_line!r}")
        lines_out.append((raw_indent, stripped))
    return lines_out


def _match_cond_header(text: str, prog: str) -> tuple[str, str | None] | None:
    if text == "if" or text.startswith("if ") or text.startswith("if:"):
        cond = text[2:].strip()
        if not cond or cond == ":":
            raise SystemExit(f"{prog}: empty if condition")
        _validate_if_condition_tokens(cond, prog)
        return "if", cond
    if text in ("else if", "elif") or text.startswith("else if ") or text.startswith("elif "):
        kw = "else if" if text.startswith("else if") else "elif"
        cond = text[len(kw) :].strip()
        if not cond or cond == ":":
            raise SystemExit(f"{prog}: empty {kw} condition")
        _validate_if_condition_tokens(cond, prog)
        return "elif", cond
    if text == "else" or text.startswith("else ") or text == "else:":
        if text == "else:":
            raise SystemExit(f"{prog}: trailing ':' is not allowed in 'else'")
        rest = text[4:].strip()
        if rest:
            raise SystemExit(f"{prog}: unexpected text after 'else': {text!r}")
        return "else", None
    return None


def parse_bundle_ast(raw_text: str, prog: str | None = None) -> list[tuple[str, object]]:
    """Parse bundle text into an AST of ('line', text) and ('if_chain', branches).

    Each branch in 'if_chain' is (cond_expr_or_None, trace_cond_str, body_ast).
    """
    p = prog or prog_name()
    lines = _preprocess_bundle_lines(raw_text, p)
    n = len(lines)

    def parse_block(start_idx: int, expected_indent: int) -> tuple[list[tuple[str, object]], int]:
        stmts: list[tuple[str, object]] = []
        idx = start_idx
        while idx < n:
            indent, text = lines[idx]
            if indent < expected_indent:
                break
            if indent > expected_indent:
                raise SystemExit(f"{p}: unexpected indentation at {text!r}")
            hdr = _match_cond_header(text, p)
            if hdr is None:
                stmts.append(("line", text))
                idx += 1
                continue
            kw, cond = hdr
            if kw in ("elif", "else"):
                raise SystemExit(f"{p}: unexpected {kw!r} without matching 'if': {text!r}")
            assert cond is not None
            branches: list[tuple[str | None, str, list[tuple[str, object]]]] = []
            idx += 1
            if idx >= n or lines[idx][0] <= expected_indent:
                raise SystemExit(f"{p}: expected 4-space indented block after 'if {cond}'")
            if lines[idx][0] != expected_indent + 4:
                raise SystemExit(f"{p}: expected 4-space indented block after 'if {cond}' (got {lines[idx][0] - expected_indent} spaces)")
            body, idx = parse_block(idx, expected_indent + 4)
            if not body:
                raise SystemExit(f"{p}: empty 'if {cond}' block")
            branches.append((cond, cond, body))
            seen_else = False
            while idx < n and lines[idx][0] == expected_indent:
                next_hdr = _match_cond_header(lines[idx][1], p)
                if next_hdr is None or next_hdr[0] == "if":
                    break
                n_kw, n_cond = next_hdr
                if seen_else:
                    raise SystemExit(f"{p}: unexpected {n_kw!r} after 'else': {lines[idx][1]!r}")
                hdr_label = lines[idx][1]
                idx += 1
                if idx >= n or lines[idx][0] <= expected_indent:
                    raise SystemExit(f"{p}: expected 4-space indented block after {hdr_label!r}")
                if lines[idx][0] != expected_indent + 4:
                    raise SystemExit(f"{p}: expected 4-space indented block after {hdr_label!r}")
                b_body, idx = parse_block(idx, expected_indent + 4)
                if not b_body:
                    raise SystemExit(f"{p}: empty {hdr_label!r} block")
                if n_kw == "else":
                    seen_else = True
                    branches.append((None, "else", b_body))
                else:
                    assert n_cond is not None
                    branches.append((n_cond, n_cond, b_body))
            stmts.append(("if_chain", branches))
        return stmts, idx

    ast_root, end_idx = parse_block(0, 0)
    if end_idx < n:
        raise SystemExit(f"{p}: unexpected indentation at {lines[end_idx][1]!r}")
    return ast_root


def strip_if_blocks_and_lines(raw_text: str, prog: str | None = None) -> list[tuple[str | None, str]]:
    """Flatten bundle AST into (cond_expr_or_None, inner_line) pairs."""
    p = prog or prog_name()
    out: list[tuple[str | None, str]] = []

    def walk(nodes: list[tuple[str, object]], stack: list[str]) -> None:
        for kind, payload in nodes:
            if kind == "line":
                comb = " ".join(c for c in stack if c and c != "else") or None
                out.append((comb, str(payload)))
            elif kind == "if_chain":
                for _cond, trace_c, body in payload:  # type: ignore[misc]
                    walk(body, [*stack, trace_c])

    walk(parse_bundle_ast(raw_text, p), [])
    return out


def _parse_md_text(raw_text: str, fallback_desc: str) -> tuple[str, str]:
    cleaned = re.sub(r"<!--.*?-->", "", raw_text, flags=re.DOTALL)
    lines = cleaned.splitlines()
    desc = fallback_desc
    body_lines: list[str] = []
    in_fence = False
    for idx, line in enumerate(lines):
        s = line.strip()
        if idx == 0 and s.startswith("# Description:"):
            desc = s.split(":", 1)[1].strip()
            continue
        if s.startswith("```"):
            in_fence = not in_fence
        if not in_fence and re.match(r"^#(?!#)", s):
            continue
        body_lines.append(line)
    return desc, "\n".join(body_lines).strip("\r\n")


def _parse_rule_directive_tokens(tokens: list[str], prog: str) -> tuple[list[str], dict[str, str]]:
    if not tokens:
        raise SystemExit(f"{prog}: missing target in rule directive")
    targets: list[str] = []
    vars_map: dict[str, str] = {}
    seen_var = False
    for tok in tokens:
        s = tok.strip()
        if not s:
            continue
        if s.startswith("-"):
            raise SystemExit(f"{prog}: excludes are not supported: {s!r}")
        if "=" in s:
            seen_var = True
            k, v = s.split("=", 1)
            k_clean = k.strip()
            if not VAR_NAME_RE.fullmatch(k_clean):
                raise SystemExit(f"{prog}: invalid variable name {k_clean!r} in {s!r}")
            vars_map[k_clean] = v.strip()
        elif not seen_var:
            targets.append(s)
        else:
            raise SystemExit(f"{prog}: unexpected argument {s!r} after key=val in rule directive")
    if not targets:
        raise SystemExit(f"{prog}: missing target in rule directive")
    return targets, vars_map


def _parse_directive_tokens(tokens: list[str], prog: str) -> tuple[str, list[str], dict[str, str]]:
    if not tokens:
        raise SystemExit(f"{prog}: missing target in bundle/rule directive")
    targets, vars_map = _parse_rule_directive_tokens(tokens, prog)
    if len(targets) > 1:
        raise SystemExit(f"{prog}: unexpected argument {targets[1]!r} after target {targets[0]!r}")
    return targets[0], [], vars_map


def _load_package_from_dir(
    pkg_dir: Path,
) -> tuple[
    dict[str, tuple[str, str]],
    dict[str, tuple[str, str]],
]:
    rules: dict[str, tuple[str, str]] = {}
    bundles: dict[str, tuple[str, str]] = {}
    a_root = pkg_dir / "agents"
    if a_root.is_dir():
        for p in sorted(a_root.rglob("*.md")):
            if p.is_file() and p.name.upper() not in ("AGENTS.MD", "README.MD"):
                rel = p.relative_to(a_root).with_suffix("").as_posix().lower()
                rules[rel] = _parse_md_text(p.read_text(encoding="utf-8", errors="replace"), rel)
        for p in sorted(a_root.rglob("*.bundle")):
            if p.is_file():
                rel = p.relative_to(a_root).with_suffix("").as_posix().lower()
                bundles[rel] = _parse_md_text(p.read_text(encoding="utf-8", errors="replace"), rel)
    return dict(sorted(rules.items())), dict(sorted(bundles.items()))


URL_ORIGIN_SUFFIX = ".origin"
_REFRESHED: set[str] = set()


def _first_refresh(key: str, refresh: bool) -> bool:
    """Honor a refresh request only once per process for each remote key."""
    if not refresh or key in _REFRESHED:
        return False
    _REFRESHED.add(key)
    return True


def _split_pkg_ref(pkg_spec: str, prog: str) -> tuple[str, str]:
    if "@" in pkg_spec and not pkg_spec.startswith("git@"):
        repo_part, ref = pkg_spec.rsplit("@", 1)
        if not repo_part.strip() or not ref.strip():
            raise SystemExit(f"{prog}: invalid package reference {pkg_spec!r}")
        return repo_part, ref
    if pkg_spec.startswith("git@") and "@" in pkg_spec[4:]:
        repo_part, ref = pkg_spec.rsplit("@", 1)
        if not repo_part.strip() or not ref.strip():
            raise SystemExit(f"{prog}: invalid package reference {pkg_spec!r}")
        return repo_part, ref
    return pkg_spec, ""


def _ensure_remote_package(pkg_spec: str, refresh: bool = False) -> Path:
    prog = prog_name()
    repo_part, ref = _split_pkg_ref(pkg_spec, prog)
    local_override = os.environ.get("CONTEXT_BUNDLE_LOCAL_PKG_DIR")
    if not ref and local_override and Path(local_override).is_dir():
        lo_path = Path(local_override)
        sub_pkg = lo_path / repo_part
        if sub_pkg.is_dir():
            return sub_pkg
        if pkg_spec == DEFAULT_RULES_PKG or (lo_path / "agents").is_dir():
            return lo_path
    refresh = _first_refresh(f"pkg:{pkg_spec}", refresh)

    if repo_part.startswith(("http://", "https://", "git@")):
        url = repo_part
        slug = re.sub(r"[^A-Za-z0-9._-]+", "_", repo_part.strip("/"))
    elif re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo_part):
        url = f"https://github.com/{repo_part}.git"
        slug = repo_part
    else:
        raise SystemExit(f"{prog}: invalid package reference {pkg_spec!r}")

    cdir = cache_dir_path() / "packages" / (f"{slug}@{ref}" if ref else slug)
    if cdir.is_dir() and not refresh:
        return cdir
    cdir.parent.mkdir(parents=True, exist_ok=True)
    if cdir.is_dir() and refresh:
        shutil.rmtree(cdir, ignore_errors=True)
    cmd = ["git", "clone", "--depth", "1"]
    if ref:
        cmd.extend(["--branch", ref])
    cmd.extend([url, str(cdir)])
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if r.returncode != 0:
        raise SystemExit(f"{prog}: failed to fetch package {pkg_spec!r}: {r.stderr.strip()}")
    return cdir


def _resolve_package_dir(
    pkg_id: str,
    work_dir: Path | None = None,
    refresh: bool = False,
) -> Path:
    prog = prog_name()
    is_explicit_path = pkg_id in (".", "..") or pkg_id.startswith(("./", "../", "~/", "/"))
    if "@" not in pkg_id or is_explicit_path:
        local_dir = Path(pkg_id).expanduser()
        if work_dir is not None and not local_dir.is_absolute():
            cand = (work_dir / local_dir).resolve()
            if cand.is_dir():
                return cand
        if local_dir.is_dir():
            return local_dir.resolve()
        if is_explicit_path:
            raise SystemExit(f"{prog}: package directory not found: {pkg_id}")
    return _ensure_remote_package(pkg_id, refresh=refresh)


def _get_package_catalog(
    pkg_id: str,
    refresh: bool = False,
    work_dir: Path | None = None,
) -> tuple[
    dict[str, tuple[str, str]],
    dict[str, tuple[str, str]],
]:
    pkg_dir = _resolve_package_dir(pkg_id, work_dir=work_dir, refresh=refresh)
    return _load_package_from_dir(pkg_dir)


def _download_url_text(url: str) -> str:
    import urllib.request

    req = urllib.request.Request(url, headers={"User-Agent": f"context-bundle/{VERSION}"})
    with urllib.request.urlopen(req, timeout=15) as resp:
        return resp.read().decode("utf-8")


def _fetch_url_file(url: str, refresh: bool = False) -> Path:
    prog = prog_name()
    slug = re.sub(r"[^A-Za-z0-9._-]+", "_", url)
    cpath = cache_dir_path() / "urls" / slug
    refresh = _first_refresh(f"url:{url}", refresh)
    if cpath.is_file() and not refresh:
        return cpath
    cpath.parent.mkdir(parents=True, exist_ok=True)
    try:
        data = _download_url_text(url)
        cpath.write_text(data, encoding="utf-8")
        cpath.with_name(cpath.name + URL_ORIGIN_SUFFIX).write_text(url + "\n", encoding="utf-8")
    except Exception as exc:
        raise SystemExit(f"{prog}: failed to fetch {url!r}: {exc}")
    return cpath


def _is_local_path_spec(spec: str) -> bool:
    s = spec.strip()
    return s in (".", "..") or s.startswith(("./", "../", "~/", "/"))


def _is_repo_shorthand_spec(spec: str) -> bool:
    s = spec.strip()
    if ":" in s or _is_local_path_spec(s) or s.startswith(("http://", "https://", "file://")):
        return False
    return re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+(?:@[A-Za-z0-9_./-]+)?", s) is not None


def _parse_target_spec(
    spec: str,
    default_pkg: str | None = None,
    allow_repo_shorthand: bool = False,
) -> tuple[str, str]:
    prog = prog_name()
    if ":" not in spec and _is_local_path_spec(spec):
        return "__file__", spec.strip()
    if spec.startswith(("http://", "https://", "file://")):
        idx = spec.rfind(":")
        scheme_end = spec.find("://") + 2
        if idx <= scheme_end or spec.endswith((".md", ".bundle")):
            return "__url__", spec
        return spec[:idx], spec[idx + 1:].strip().lower()
    if ":" not in spec:
        s_clean = spec.strip()
        if allow_repo_shorthand and _is_repo_shorthand_spec(s_clean):
            repo_leaf = s_clean.split("@", 1)[0].rsplit("/", 1)[-1].lower()
            return s_clean, repo_leaf
        if default_pkg:
            return default_pkg, s_clean.lower()
        raise SystemExit(
            f"{prog}: missing package prefix in {spec!r} (expected '<owner>/<repo>:{spec}' or './path')"
        )
    pkg, item = spec.split(":", 1)
    if not pkg.strip() or not item.strip():
        raise SystemExit(f"{prog}: invalid target {spec!r}; expected <package>:<item>")
    return pkg.strip(), item.strip().lower()


def _strip_item_affixes(
    name: str,
    prefixes: tuple[str, ...],
    suffixes: tuple[str, ...],
) -> list[str]:
    s = name.strip().lower()
    while s.startswith("./"):
        s = s[2:]
    for suf in suffixes:
        if s.endswith(suf) and len(s) > len(suf):
            s = s[: -len(suf)]
            break
    candidates = [s]
    for pref in prefixes:
        if s.startswith(pref) and len(s) > len(pref):
            stripped = s[len(pref) :]
            if stripped not in candidates:
                candidates.append(stripped)
    return candidates


def _match_exact_or_norm(key: str, mapping: dict[str, object]) -> str | None:
    if key in mapping:
        return key
    norm = key.replace("-", "_")
    for k in mapping:
        if k.replace("-", "_") == norm:
            return k
    return None


def _match_rule_in_dict(name: str, rules_dict: dict[str, tuple[str, str]]) -> str | None:
    for cand in _strip_item_affixes(name, ("agents/",), (".md",)):
        hit = _match_exact_or_norm(cand, rules_dict)
        if hit is not None:
            return hit
        norm = cand.replace("-", "_")
        matches = [k for k in rules_dict if k.rsplit("/", 1)[-1].replace("-", "_") == norm]
        if len(matches) == 1:
            return matches[0]
    return None


def _match_bundle_in_dict(
    name: str,
    bundles_dict: dict[str, tuple[str, str]],
    repo_shorthand: bool = False,
) -> str | None:
    for cand in _strip_item_affixes(
        name,
        ("agents/",),
        (".bundle",),
    ):
        leaf = cand.rsplit("/", 1)[-1]
        for probe in (cand, f"{cand}/{leaf}", f"{cand}/default"):
            hit = _match_exact_or_norm(probe, bundles_dict)
            if hit is not None:
                return hit
        norm = cand.replace("-", "_")
        if norm != "default":
            matches = [k for k in bundles_dict if k.rsplit("/", 1)[-1].replace("-", "_") == norm]
            if len(matches) == 1:
                return matches[0]
    if repo_shorthand:
        for probe in ("default", "default/default"):
            hit = _match_exact_or_norm(probe, bundles_dict)
            if hit is not None:
                return hit
    return None


def _resolve_package_rel_file(
    pkg_dir: Path,
    raw_item: str,
    suffixes: tuple[str, ...],
) -> tuple[str, Path] | None:
    prog = prog_name()
    clean = raw_item.strip()
    if not clean or Path(clean).is_absolute():
        return None
    pkg_root = pkg_dir.resolve()
    candidates = [pkg_dir / clean]
    for suf in suffixes:
        if not clean.lower().endswith(suf):
            candidates.append(pkg_dir / f"{clean}{suf}")
    for cand in candidates:
        resolved = cand.resolve()
        try:
            rel = resolved.relative_to(pkg_root)
        except ValueError:
            raise SystemExit(f"{prog}: package path escapes package root: {raw_item}")
        if resolved.is_file():
            rel_key = (
                rel.with_suffix("").as_posix().lower()
                if rel.suffix.lower() in suffixes
                else rel.as_posix().lower()
            )
            return rel_key, resolved
    return None


def _find_bundle_file_in_pkg(pkg_dir: Path, ik: str) -> Path | None:
    cand = pkg_dir / "agents" / f"{ik}.bundle"
    if cand.is_file():
        return cand.resolve()
    return None


def _is_external_bundle_source(
    canonical_id: str,
    child_pkg: str | None,
    child_bdir: Path | None,
    root_dir: Path | None,
    parent_is_external: bool = False,
) -> bool:
    if parent_is_external or child_pkg is not None or child_bdir is None or root_dir is None:
        return True
    try:
        fpath = Path(canonical_id).resolve()
        fpath.relative_to(root_dir.resolve())
    except ValueError:
        return True
    try:
        fpath.relative_to(cache_dir_path().resolve())
        return True
    except ValueError:
        pass
    local_override = os.environ.get("CONTEXT_BUNDLE_LOCAL_PKG_DIR")
    if local_override:
        try:
            fpath.relative_to(Path(local_override).resolve())
            return True
        except ValueError:
            pass
    return False


def _resolve_bundle_context(
    target_spec: str,
    work_dir: Path | None = None,
    refresh: bool = False,
    default_pkg: str | None = DEFAULT_RULES_PKG,
    kind_label: str = "bundle",
) -> tuple[str, str, str | None, Path | None, Path | None]:
    prog = prog_name()
    pkg_id, item_name = _parse_target_spec(target_spec, default_pkg=default_pkg, allow_repo_shorthand=True)
    if pkg_id in ("__file__", "__url__"):
        if pkg_id == "__url__":
            fpath = _fetch_url_file(item_name, refresh=refresh)
            raw = fpath.read_text(encoding="utf-8", errors="replace")
            return item_name, _parse_md_text(raw, fpath.stem)[1], None, None, None
        fpath = Path(item_name).expanduser()
        if work_dir is not None and not fpath.is_absolute():
            fpath = (work_dir / fpath).resolve()
        else:
            fpath = fpath.resolve()
        if fpath.is_dir():
            _, bundles_dict = _load_package_from_dir(fpath)
            ik = _match_bundle_in_dict(fpath.name.lower(), bundles_dict, repo_shorthand=True)
            if ik is None:
                avail_i = sorted(bundles_dict.keys())
                raise SystemExit(
                    f"{prog}: unknown {kind_label} {fpath.name!r} in package {str(fpath)!r} "
                    f"(available {kind_label}s: {', '.join(avail_i)})"
                )
            bfile = _find_bundle_file_in_pkg(fpath, ik)
            bdir = bfile.parent if bfile is not None else fpath
            return f"{fpath}:{ik}", bundles_dict[ik][1], str(fpath), fpath, bdir
        if not fpath.is_file() and not fpath.suffix and fpath.with_suffix(".bundle").is_file():
            fpath = fpath.with_suffix(".bundle").resolve()
        if not fpath.is_file():
            raise SystemExit(f"{prog}: {kind_label} file not found: {item_name}")
        raw = fpath.read_text(encoding="utf-8", errors="replace")
        return str(fpath), _parse_md_text(raw, fpath.stem)[1], None, None, fpath.parent

    s_clean = target_spec.strip()
    is_shorthand = _is_repo_shorthand_spec(s_clean)
    raw_item = s_clean.split(":", 1)[1].strip() if ":" in s_clean else item_name
    pkg_dir = _resolve_package_dir(pkg_id, work_dir=work_dir, refresh=refresh)
    _, bundles_dict = _load_package_from_dir(pkg_dir)
    ik = _match_bundle_in_dict(item_name, bundles_dict, repo_shorthand=is_shorthand)
    if ik is not None:
        bfile = _find_bundle_file_in_pkg(pkg_dir, ik)
        bdir = bfile.parent if bfile is not None else pkg_dir
        return f"{pkg_id}:{ik}", bundles_dict[ik][1], pkg_id, pkg_dir, bdir
    rel_match = _resolve_package_rel_file(pkg_dir, raw_item, (".bundle",))
    if rel_match is None:
        avail_i = sorted(bundles_dict.keys())
        raise SystemExit(
            f"{prog}: unknown {kind_label} {item_name!r} in package {pkg_id!r} "
            f"(available {kind_label}s: {', '.join(avail_i)})"
        )
    ik, bfile = rel_match
    raw = bfile.read_text(encoding="utf-8", errors="replace")
    return f"{pkg_id}:{ik}", _parse_md_text(raw, bfile.stem)[1], pkg_id, pkg_dir, bfile.parent


def resolve_bundle_source(
    target_spec: str,
    work_dir: Path | None = None,
    refresh: bool = False,
    default_pkg: str | None = DEFAULT_RULES_PKG,
) -> tuple[str, str]:
    canonical_id, body, _, _, _ = _resolve_bundle_context(
        target_spec,
        work_dir=work_dir,
        refresh=refresh,
        default_pkg=default_pkg,
    )
    return canonical_id, body


def resolve_bundle_text(
    target_spec: str,
    work_dir: Path | None = None,
    refresh: bool = False,
    default_pkg: str | None = DEFAULT_RULES_PKG,
) -> str:
    return resolve_bundle_source(
        target_spec,
        work_dir=work_dir,
        refresh=refresh,
        default_pkg=default_pkg,
    )[1]


def collect_directive_items(
    kind: str,
    target_spec: str,
    excludes: list[str] | None = None,
    cli_vars: dict[str, str] | None = None,
    work_dir: Path | None = None,
    refresh: bool = False,
    default_pkg: str | None = None,
    trace_prefix: list[str] | None = None,
    piped: bool = False,
    chain: list[str] | None = None,
    active_bundles: list[tuple[str, str]] | None = None,
) -> list[tuple[str, str, str, list[str]]]:
    """Returns list of (rule_uid, provenance_comment, rendered_body, chain)."""
    prog = prog_name()
    if kind not in ("bundle", "rule"):
        raise SystemExit(f"{prog}: directive kind must be 'bundle' or 'rule' (got {kind!r})")
    if excludes:
        raise SystemExit(f"{prog}: excludes are not supported: {excludes[0]!r}")

    effective_vars = {**builtin_vars(work_dir, piped=piped), **(cli_vars or {})}
    target_spec = _render_rule_vars(target_spec, effective_vars)
    base_chain = list(chain) if chain else []
    cur_trace = list(trace_prefix or [f"{kind} {target_spec}"])

    if kind == "bundle":
        canonical_id, body_text, child_pkg, _child_pkg_dir, child_bdir = _resolve_bundle_context(
            target_spec,
            work_dir=work_dir,
            refresh=refresh,
            default_pkg=default_pkg or DEFAULT_RULES_PKG,
            kind_label=kind,
        )
        pkg_id, item_name = _parse_target_spec(
            target_spec,
            default_pkg=default_pkg or DEFAULT_RULES_PKG,
            allow_repo_shorthand=True,
        )
        bundle_spec = (
            target_spec
            if (pkg_id in ("__file__", "__url__") or _is_repo_shorthand_spec(target_spec.strip()))
            else f"{pkg_id}:{item_name}"
        )
        next_bundles: list[tuple[str, str]] = list(active_bundles) if active_bundles else []
        if any(cid == canonical_id for cid, _ in next_bundles):
            cycle_path = " -> ".join([*(lbl for _, lbl in next_bundles), bundle_spec])
            raise SystemExit(f"{prog}: circular bundle reference detected: {cycle_path}")
        next_bundles = [*next_bundles, (canonical_id, bundle_spec)]
        bundle_chain = [*base_chain, bundle_spec]
        base_url = item_name.rsplit("/", 1)[0] if (pkg_id == "__url__" and "/" in item_name) else None
        sub_wdir = child_bdir if child_bdir is not None else work_dir
        local_vars = dict(effective_vars)
        items_out: list[tuple[str, str, str, list[str]]] = []

        def exec_nodes(nodes: list[tuple[str, object]], cond_stack: list[str]) -> None:
            for n_kind, payload in nodes:
                if n_kind == "if_chain":
                    for b_cond, b_trace, b_body in payload:  # type: ignore[misc]
                        if b_cond is None or eval_if_condition(b_cond, local_vars, prog):
                            exec_nodes(b_body, [*cond_stack, b_trace])
                            break
                    continue
                raw_line = str(payload)
                rendered_line = _render_rule_vars(raw_line, local_vars).strip()
                if not rendered_line:
                    continue
                if rendered_line == "let" or rendered_line.startswith("let "):
                    assign = rendered_line[len("let") :].strip()
                    if "=" not in assign:
                        raise SystemExit(f"{prog}: invalid let directive: {rendered_line!r}")
                    k, v_expr = assign.split("=", 1)
                    k_clean = k.strip()
                    if not VAR_NAME_RE.fullmatch(k_clean):
                        raise SystemExit(f"{prog}: invalid variable name {k_clean!r} in {rendered_line!r}")
                    if not local_vars.get(k_clean) and v_expr.strip():
                        local_vars[k_clean] = v_expr.strip()
                    continue
                if rendered_line == "export" or rendered_line.startswith(("export ", "file ", "cmd ", "prompt ", "allow ")):
                    continue
                parts = shlex.split(rendered_line)
                if not parts or parts[0] not in ("bundle", "rule"):
                    raise SystemExit(
                        f"{prog}: invalid line in {kind} {target_spec!r}: {rendered_line!r}"
                    )
                sub_kind = parts[0]
                if sub_kind == "rule":
                    sub_targets, sub_vars = _parse_rule_directive_tokens(parts[1:], prog)
                else:
                    s_tgt, _ex, sub_vars = _parse_directive_tokens(parts[1:], prog)
                    sub_targets = [s_tgt]
                merged_vars = {**local_vars, **sub_vars, **(cli_vars or {})}
                cond_s = " ".join(c for c in cond_stack if c and c != "else")
                for sub_target in sub_targets:
                    step_label = f"if {cond_s} {sub_kind} {sub_target}" if cond_s else f"{sub_kind} {sub_target}"
                    qual_target = (
                        f"{base_url}/{sub_target}"
                        if (base_url and ":" not in sub_target and sub_target.endswith((".md", ".bundle")))
                        else sub_target
                    )
                    items_out.extend(
                        collect_directive_items(
                            sub_kind,
                            qual_target,
                            cli_vars=merged_vars,
                            work_dir=sub_wdir,
                            refresh=refresh,
                            default_pkg=child_pkg or DEFAULT_RULES_PKG,
                            trace_prefix=[*cur_trace, step_label],
                            piped=piped,
                            chain=bundle_chain,
                            active_bundles=next_bundles,
                        )
                    )

        exec_nodes(parse_bundle_ast(body_text, prog), [])
        return items_out

    pkg_id, item_name = _parse_target_spec(target_spec, default_pkg=default_pkg)
    if pkg_id in ("__file__", "__url__"):
        if pkg_id == "__url__":
            fpath = _fetch_url_file(item_name, refresh=refresh)
        else:
            fpath = Path(item_name).expanduser()
            if work_dir is not None and not fpath.is_absolute():
                fpath = (work_dir / fpath).resolve()
            else:
                fpath = fpath.resolve()
            if not fpath.is_file() and not fpath.suffix and fpath.with_suffix(".md").is_file():
                fpath = fpath.with_suffix(".md").resolve()
            if not fpath.is_file():
                raise SystemExit(f"{prog}: rule file not found: {item_name}")
        raw = fpath.read_text(encoding="utf-8", errors="replace")
        _, body = _parse_md_text(raw, fpath.stem)
        rendered = _render_rule_vars(body, effective_vars).strip()
        if not rendered:
            return []
        used_keys = {m.group(1) for m in RULE_VAR_RE.finditer(body)}
        active_vars = {k: v for k, v in effective_vars.items() if k in used_keys}
        vars_s = f" ({', '.join(f'{k}={v}' for k, v in active_vars.items())})" if active_vars else ""
        prov = f"# [{' -> '.join(cur_trace)}]{vars_s}"
        return [(str(fpath), prov, rendered, list(base_chain))]

    s_clean = target_spec.strip()
    raw_item = s_clean.split(":", 1)[1].strip() if ":" in s_clean else item_name
    pkg_dir = _resolve_package_dir(pkg_id, work_dir=work_dir, refresh=refresh)
    rules_dict, _ = _load_package_from_dir(pkg_dir)

    rk = _match_rule_in_dict(item_name, rules_dict)
    if rk is not None:
        raw_body = rules_dict[rk][1].strip()
    else:
        rel_match = _resolve_package_rel_file(pkg_dir, raw_item, (".md",))
        if rel_match is None:
            avail_r = sorted(rules_dict.keys())
            raise SystemExit(
                f"{prog}: unknown rule {item_name!r} in package {pkg_id!r} (available rules: {', '.join(avail_r)})"
            )
        rk, fpath = rel_match
        raw_body = _parse_md_text(fpath.read_text(encoding="utf-8", errors="replace"), rk)[1].strip()
    rendered = _render_rule_vars(raw_body, effective_vars)
    if not rendered:
        return []
    used_keys = {m.group(1) for m in RULE_VAR_RE.finditer(raw_body)}
    active_vars = {k: v for k, v in effective_vars.items() if k in used_keys}
    trace_chain = (
        [*cur_trace, f"agents/{rk}.md"]
        if (len(cur_trace) > 1 and cur_trace[-1].startswith("if "))
        else [*(cur_trace[:-1] if len(cur_trace) > 1 else cur_trace), f"agents/{rk}.md"]
    )
    vars_s = f" ({', '.join(f'{k}={v}' for k, v in active_vars.items())})" if active_vars else ""
    prov = f"# [{' -> '.join(trace_chain)}]{vars_s}"
    return [(f"{pkg_id}:{rk}", prov, rendered, list(base_chain))]


def format_bundle_part_marker(nonce: str, meta: dict[str, object]) -> str:
    payload = json.dumps(meta, ensure_ascii=False).replace("-->", "--\\u003e")
    return f"<!-- bundle:{nonce}:part {payload} -->"


def format_bundle_end_marker(nonce: str) -> str:
    return f"<!-- bundle:{nonce}:end -->"


def wrap_bundle_fragment(nonce: str | None, meta: dict[str, object], content: str) -> str:
    if not nonce:
        return content
    part_line = format_bundle_part_marker(nonce, meta)
    end_line = format_bundle_end_marker(nonce)
    if content:
        return f"{part_line}\n{content}\n{end_line}"
    return f"{part_line}\n{end_line}"


def format_collected_rules(
    items: list[tuple[str, str, str, list[str]]],
    verbose: bool = False,
    boundary: str | None = None,
) -> str:
    seen: set[str] = set()
    chunks: list[str] = []
    for item in items:
        uid, prov, body = item[0], item[1], item[2]
        if uid in seen:
            continue
        seen.add(uid)
        chain = list(item[3]) if len(item) > 3 else []
        chunk = f"{prov}\n{body}" if verbose else body
        if boundary:
            chunk = wrap_bundle_fragment(
                boundary,
                {
                    "kind": "rule",
                    "id": uid,
                    "chain": chain,
                },
                chunk,
            )
        chunks.append(chunk)
    sep = "\n\n" if verbose else "\n"
    return sep.join(chunks)


def render_directive(
    kind: str,
    target_spec: str,
    excludes: list[str] | None = None,
    cli_vars: dict[str, str] | None = None,
    work_dir: Path | None = None,
    refresh: bool = False,
    default_pkg: str | None = None,
    verbose: bool = False,
) -> str:
    items = collect_directive_items(
        kind,
        target_spec,
        excludes=excludes,
        cli_vars=cli_vars,
        work_dir=work_dir,
        refresh=refresh,
        default_pkg=default_pkg,
    )
    return format_collected_rules(items, verbose=verbose)


def cmd_list_rules(pkg_id: str = DEFAULT_RULES_PKG) -> int:
    rules_dict, bundles_dict = _get_package_catalog(pkg_id)
    bvars = builtin_vars()
    sys.stdout.write("Built-in variables (usable in 'if key=val' conditions and rule templates):\n")
    sys.stdout.write(f"  {'os':<38}  Active operating system (linux, macos; current: {bvars['os']!r})\n")
    sys.stdout.write(f"  {'vcs':<38}  Detected repository VCS (git, cvs, or ''; current: {bvars['vcs']!r})\n")
    sys.stdout.write(f"  {'piped':<38}  Set to '1' when stdin prompt text is present, else '' (current: {bvars['piped']!r})\n\n")
    if bundles_dict:
        sys.stdout.write(f"Bundles in '{pkg_id}' (use as 'bundle {pkg_id}:<bundle>'):\n")
        for k, (desc, body) in bundles_dict.items():
            target_tag = f"{pkg_id}:{k}"
            sys.stdout.write(f"  {target_tag:<38}  {desc}\n")
            for cond_expr, line in strip_if_blocks_and_lines(body):
                cond_s = f"if {cond_expr} " if cond_expr else ""
                sys.stdout.write(f"  {'':<38}    {cond_s}{line}\n")
    sys.stdout.write(f"\nAtomic rules in '{pkg_id}' (use as 'rule {pkg_id}:<rule>'):\n")
    for k, (desc, _) in rules_dict.items():
        target_tag = f"{pkg_id}:{k}"
        sys.stdout.write(f"  {target_tag:<38}  {desc}\n")
    return 0


def _git_run(repo_root: Path, *args: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", "-C", str(repo_root), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )


def _git_head(repo_root: Path) -> str:
    return _git_run(repo_root, "rev-parse", "--short", "HEAD").stdout.strip()


def _refresh_cached_repo(repo_root: Path) -> tuple[str, str]:
    before = _git_head(repo_root)
    for args in (("fetch", "--depth", "1", "--force", "origin"), ("reset", "--hard", "FETCH_HEAD")):
        r = _git_run(repo_root, *args)
        if r.returncode != 0:
            raise RuntimeError(r.stderr.strip() or f"git {args[0]} failed")
    return before, _git_head(repo_root)


def cmd_update_cache() -> int:
    prog = prog_name()
    root = cache_dir_path()
    pdir = root / "packages"
    udir = root / "urls"
    counts = {"updated": 0, "unchanged": 0, "skipped": 0, "failed": 0}
    if pdir.is_dir():
        for git_dir in sorted(pdir.rglob(".git")):
            repo_root = git_dir.parent
            label = f"package {repo_root.relative_to(pdir).as_posix()}"
            try:
                before, after = _refresh_cached_repo(repo_root)
            except RuntimeError as exc:
                counts["failed"] += 1
                sys.stderr.write(f"{prog}: {label}: failed: {exc}\n")
                continue
            if before == after:
                counts["unchanged"] += 1
                sys.stdout.write(f"{label}: up to date ({after})\n")
            else:
                counts["updated"] += 1
                sys.stdout.write(f"{label}: updated {before} -> {after}\n")
    if udir.is_dir():
        cached = sorted(p for p in udir.iterdir() if p.is_file() and not p.name.endswith(URL_ORIGIN_SUFFIX))
        for cpath in cached:
            origin = cpath.with_name(cpath.name + URL_ORIGIN_SUFFIX)
            if not origin.is_file():
                counts["skipped"] += 1
                sys.stdout.write(f"url {cpath.name}: skipped (source URL not recorded; re-fetch with --refresh)\n")
                continue
            url = origin.read_text(encoding="utf-8").strip()
            label = f"url {url}"
            try:
                data = _download_url_text(url)
            except Exception as exc:
                counts["failed"] += 1
                sys.stderr.write(f"{prog}: {label}: failed: {exc}\n")
                continue
            if cpath.read_text(encoding="utf-8", errors="replace") == data:
                counts["unchanged"] += 1
                sys.stdout.write(f"{label}: unchanged\n")
            else:
                cpath.write_text(data, encoding="utf-8")
                counts["updated"] += 1
                sys.stdout.write(f"{label}: updated\n")
    if sum(counts.values()) == 0:
        sys.stdout.write(f"No cached packages or URL files in {root}\n")
        return 0
    sys.stdout.write(
        "Refreshed cache: "
        f"{counts['updated']} updated, {counts['unchanged']} unchanged, "
        f"{counts['skipped']} skipped, {counts['failed']} failed.\n"
    )
    return 1 if counts["failed"] else 0


_LINE_RANGE_RE = re.compile(r"^(.*?):(\d+)(?:-(\d+))?$")
_GLOB_SKIP_DIRS = {".git", "__pycache__"}
_HEAD_SLICE_RE = re.compile(r"^===== [$] sed -n '(\d+),(\d+)p' (.+) =====\Z")
_HEAD_CAT_RE = re.compile(r"^===== [$] cat (.+) =====\Z")


def _is_within_root(path: Path, root: Path) -> bool:
    try:
        path.resolve().relative_to(root.resolve())
        return True
    except ValueError:
        return False


def _expand_include(
    wdir: Path,
    spec: str,
    root_dir: Path | None = None,
    bundle_label: str | None = None,
) -> list[tuple[Path, int | None, int | None]]:
    """Resolve an include item to (file, start, end) slices; empty when nothing matches.

    An existing file named exactly by spec is always included whole. Otherwise an
    optional :START-END (or :LINE) 1-based inclusive suffix is split off and the
    remaining path is used as a file or, when relative, as a glob pattern.
    """
    resolved_root = root_dir.resolve() if root_dir is not None else None

    def to_abs(raw: str) -> Path:
        p = Path(raw)
        return p.resolve() if p.is_absolute() else (wdir / raw).resolve()

    def ensure_within_root(candidate: Path) -> None:
        if resolved_root is not None and not _is_within_root(candidate, resolved_root):
            prog = prog_name()
            origin = f" in external bundle {bundle_label!r}" if bundle_label else ""
            raise SystemExit(
                f"{prog}: include path {spec!r}{origin} resolves outside repository root {resolved_root}"
            )

    whole = to_abs(spec)
    if whole.is_file():
        ensure_within_root(whole)
        return [(whole, None, None)]
    base, start, end = spec, None, None
    m = _LINE_RANGE_RE.match(spec)
    if m:
        base = m.group(1)
        start = int(m.group(2))
        end = int(m.group(3) or start)
        if start < 1 or end < start:
            return []
    if not base:
        return []
    if Path(base).is_absolute() or not any(c in base for c in "*?["):
        target = to_abs(base)
        ensure_within_root(target)
        return [(target, start, end)] if target.is_file() else []
    if resolved_root is not None:
        prefix_parts: list[str] = []
        for part in Path(base).parts:
            if any(c in part for c in "*?["):
                break
            prefix_parts.append(part)
        if prefix_parts:
            ensure_within_root(to_abs(Path(*prefix_parts).as_posix()))
        if ".." in Path(base).parts:
            ensure_within_root(to_abs(base))
    try:
        matches = sorted(wdir.glob(base))
    except (ValueError, NotImplementedError):
        return []
    results: list[tuple[Path, int | None, int | None]] = []
    for p in matches:
        if p.is_file() and not _GLOB_SKIP_DIRS.intersection(p.parts[len(wdir.parts) :]):
            resolved_p = p.resolve()
            ensure_within_root(resolved_p)
            results.append((resolved_p, start, end))
    return results


def display_path(path: Path, base: Path) -> str:
    try:
        return path.relative_to(base).as_posix()
    except ValueError:
        return path.as_posix()


class IncludeSpan:
    """One included file region.

    A whole-file span carries whole_text (start and end are None); a slice span
    carries lines, mapping 1-based line numbers to text, for the inclusive
    requested range start..end.
    """

    def __init__(
        self,
        key: str,
        disp: str,
        start: int | None,
        end: int | None,
        lines: dict[int, str],
        chain: list[str],
        whole_text: str | None = None,
    ) -> None:
        self.key = key
        self.disp = disp
        self.start = start
        self.end = end
        self.lines = lines
        self.chain = chain
        self.whole_text = whole_text


def read_span(path: Path, disp: str, start: int | None, end: int | None, chain: list[str]) -> IncludeSpan:
    text = path.read_text(encoding="utf-8", errors="replace")
    if start is None or end is None:
        return IncludeSpan(str(path), disp, None, None, {}, list(chain), whole_text=text)
    text_lines = text.splitlines()
    picked = {n: text_lines[n - 1] for n in range(start, min(end, len(text_lines)) + 1)}
    return IncludeSpan(str(path), disp, start, end, picked, list(chain))


def _span_key(resolved: object, disp: str, wdir: Path) -> str:
    p = Path(str(resolved) if resolved else disp)
    return str((p if p.is_absolute() else wdir / p).resolve())


def span_from_fragment(meta: dict[str, object], content: str, wdir: Path) -> IncludeSpan:
    """Rebuild an include span from an upstream file fragment."""
    raw_chain = meta.get("chain")
    chain = [str(c) for c in raw_chain] if isinstance(raw_chain, list) else []
    name = str(meta.get("name") or "")
    head, _, body = content.partition("\n")
    resolved = meta.get("resolved_path")
    m_slice = _HEAD_SLICE_RE.match(head)
    if m_slice:
        start, end, disp = int(m_slice.group(1)), int(m_slice.group(2)), m_slice.group(3)
        lines = {start + i: ln for i, ln in enumerate(body.split("\n"))} if body else {}
        return IncludeSpan(_span_key(resolved, disp, wdir), disp, start, end, lines, chain)
    m_cat = _HEAD_CAT_RE.match(head)
    if m_cat:
        disp = m_cat.group(1)
        return IncludeSpan(_span_key(resolved, disp, wdir), disp, None, None, {}, chain, whole_text=body)
    return IncludeSpan(f"upstream:{name or content}", name or head, None, None, {}, chain, whole_text=content)


def _absorb(base: IncludeSpan, other: IncludeSpan) -> None:
    assert base.start is not None and base.end is not None
    assert other.start is not None and other.end is not None
    base.start = min(base.start, other.start)
    base.end = max(base.end, other.end)
    base.lines.update(other.lines)


def merge_spans(spans: list[IncludeSpan]) -> list[IncludeSpan]:
    """Deduplicate spans by line coverage, keeping first-occurrence order.

    A whole-file span absorbs every slice of the same file; overlapping or
    contained slices of one file are merged into a single slice.
    """
    out: list[IncludeSpan] = []
    for s in spans:
        same = [o for o in out if o.key == s.key]
        if any(o.whole_text is not None for o in same):
            continue
        if s.whole_text is not None:
            if same:
                s.chain = list(same[0].chain)
                out[out.index(same[0])] = s
                out = [o for o in out if o not in same[1:]]
            else:
                out.append(s)
            continue
        assert s.start is not None and s.end is not None
        hit = [o for o in same if o.start <= s.end and s.start <= o.end]
        if not hit:
            out.append(s)
            continue
        for o in (*hit[1:], s):
            _absorb(hit[0], o)
        out = [o for o in out if o not in hit[1:]]
    return out


def render_span(span: IncludeSpan) -> tuple[dict[str, object], str]:
    """Return (fragment meta, section text) for a span."""
    if span.whole_text is not None:
        name = span.disp
        heading = f"cat {span.disp}"
        content = span.whole_text.rstrip()
    else:
        name = f"{span.disp}:{span.start}-{span.end}"
        heading = f"sed -n '{span.start},{span.end}p' {span.disp}"
        content = "\n".join(span.lines[n] for n in sorted(span.lines)).rstrip()
    meta: dict[str, object] = {"kind": "file", "name": name, "chain": list(span.chain)}
    return meta, f"===== $ {heading} =====\n{content}"


_FRAGMENT_GROUPS = {
    "rule": "rules",
    "cmd": "cmds",
    "file": "files",
    "prompt": "prompts",
}
_HEADER_RE = re.compile(r"([A-Za-z][A-Za-z0-9_.-]*):(?:[ \t]+(.*)|[ \t]*)")
_PRODUCER_RE = re.compile(r"[A-Za-z_][A-Za-z0-9_-]*(?:/[A-Za-z_][A-Za-z0-9_-]*)?")
_VAR_RE = re.compile(VAR_NAME_PATTERN)


def _normalize_producer(tok: str) -> tuple[str, str]:
    p_norm = tok.lower().replace("-", "_").replace("/", ".")
    p_short = p_norm.rsplit(".", 1)[-1]
    return p_norm, p_short


class PipedInput:
    """Parsed stdin of an upstream command piped into the assembler."""

    def __init__(self) -> None:
        self.vars: dict[str, str] = {}
        self.prompt = ""
        self.workdir: str | None = None
        self.boundary: str | None = None
        self.command: str | None = None
        self.bundle_name: str | None = None
        self.producers: list[str] = []
        self.fragments: list[tuple[dict[str, object], str]] = []

    @property
    def has_prompt(self) -> bool:
        return bool(self.prompt) or any(meta.get("kind") == "prompt" for meta, _ in self.fragments)


def _parse_part_line(line: str, prefix: str) -> dict[str, object] | None:
    if not (line.startswith(prefix) and line.endswith(" -->")):
        return None
    try:
        meta = json.loads(line[len(prefix) : -len(" -->")])
    except ValueError:
        return None
    return meta if isinstance(meta, dict) else None


def extract_fragments(text: str, nonce: str) -> tuple[list[tuple[dict[str, object], str]], str]:
    """Split upstream bundle text into (meta, content) fragments and leftover prose."""
    part_prefix = f"<!-- bundle:{nonce}:part "
    end_line = f"<!-- bundle:{nonce}:end -->"
    fragments: list[tuple[dict[str, object], str]] = []
    leftover: list[str] = []
    active: dict[str, object] | None = None
    buf: list[str] = []
    for line in text.splitlines():
        if active is not None:
            if line == end_line:
                fragments.append((active, "\n".join(buf)))
                active = None
            else:
                buf.append(line)
            continue
        meta = _parse_part_line(line, part_prefix)
        if meta is not None:
            active = meta
            buf = []
        elif line.strip() not in (RULES_HEADER, PROMPT_HEADER):
            leftover.append(line)
    if active is not None:
        raise SystemExit(f"{prog_name()}: unclosed upstream fragment marker on stdin")
    return fragments, "\n".join(leftover).strip()


def group_fragments(
    fragments: list[tuple[dict[str, object], str]],
) -> tuple[dict[str, list[tuple[dict[str, object], str]]], list[str]]:
    """Group fragments into rules, cmds, files, and prompts; also return unknown kinds."""
    groups: dict[str, list[tuple[dict[str, object], str]]] = {
        "rules": [],
        "cmds": [],
        "files": [],
        "prompts": [],
    }
    unknown: list[str] = []
    for meta, content in fragments:
        group = _FRAGMENT_GROUPS.get(str(meta.get("kind")))
        if group is None:
            unknown.append(str(meta.get("kind")))
        else:
            groups[group].append((meta, content))
    return groups, unknown


def parse_stdin_pipe(stdin_text: str) -> PipedInput:
    prog = prog_name()
    result = PipedInput()
    raw = stdin_text.strip()
    if not raw:
        return result
    lines = raw.splitlines()
    preamble_items: list[tuple[str, str]] = []
    idx = 0
    while idx < len(lines):
        ln = lines[idx]
        if not ln.strip():
            break
        hm = _HEADER_RE.fullmatch(ln)
        if not hm:
            break
        preamble_items.append((hm.group(1), hm.group(2).strip() if hm.group(2) is not None else ""))
        idx += 1

    ambiguous_shorts: set[str] = set()
    if preamble_items and (idx == len(lines) or not lines[idx].strip()):
        seen_producers: set[str] = set()
        short_to_producers: dict[str, set[str]] = {}
        current_producer: str | None = None
        raw_vars: list[tuple[str | None, str, str]] = []

        for k, v in preamble_items:
            kl = k.lower()
            if kl == "workdir":
                result.workdir = v
            elif kl == "bundle-boundary":
                result.boundary = v or None
            elif kl == "bundle-command":
                result.command = v or None
            elif kl == "bundle-name":
                tokens = [tok for tok in re.split(r"[\s,|]+", v.strip()) if tok]
                if not tokens:
                    raise SystemExit(f"{prog}: empty Bundle-Name header on stdin")
                for tok in tokens:
                    if not _PRODUCER_RE.fullmatch(tok):
                        raise SystemExit(f"{prog}: invalid Bundle-Name producer {tok!r} on stdin")
                    p_norm, p_short = _normalize_producer(tok)
                    if p_norm in seen_producers:
                        raise SystemExit(f"{prog}: duplicate Bundle-Name producer {p_norm!r} in pipeline")
                    seen_producers.add(p_norm)
                    short_to_producers.setdefault(p_short, set()).add(p_norm)
                    result.producers.append(p_norm)
                    result.bundle_name = p_norm
                    current_producer = p_norm
            elif kl.startswith("bundle-"):
                continue
            elif v:
                raw_vars.append((current_producer, kl, v))

        if result.command:
            cmd_producers: list[str] = []
            for seg in result.command.split("|"):
                seg_tokens = seg.strip().split()
                if seg_tokens:
                    exe = seg_tokens[0].rsplit("/", 1)[-1].lower().replace("-", "_")
                    cmd_producers.append(exe)
            if len(cmd_producers) > 1 and len(cmd_producers) != len(set(cmd_producers)):
                for p in cmd_producers:
                    if cmd_producers.count(p) > 1:
                        if p in seen_producers:
                            raise SystemExit(f"{prog}: duplicate Bundle-Name producer {p!r} in pipeline")
                        owners = short_to_producers.get(p, set())
                        if len(owners) == 1:
                            only_prod = next(iter(owners))
                            raise SystemExit(f"{prog}: duplicate Bundle-Name producer {only_prod!r} in pipeline")

        # Also inspect pre-namespaced headers (<owner>.<repo>.<key> or <repo>.<key>)
        for assoc_prod, kl, _v in raw_vars:
            if "." in kl:
                parts = [p.replace("-", "_") for p in kl.split(".")]
                if len(parts) >= 3:
                    ns_full = f"{parts[0]}.{parts[1]}"
                    ns_short = parts[1]
                    if ns_full in seen_producers:
                        raise SystemExit(f"{prog}: duplicate Bundle-Name producer {ns_full!r} in pipeline")
                    short_to_producers.setdefault(ns_short, set()).add(ns_full)
                else:
                    ns_short = parts[0]
                    if ns_short in seen_producers:
                        raise SystemExit(f"{prog}: duplicate Bundle-Name producer {ns_short!r} in pipeline")
                    if assoc_prod and assoc_prod.rsplit(".", 1)[-1] == ns_short and ns_short in short_to_producers:
                        if len(short_to_producers[ns_short]) == 1 and assoc_prod in short_to_producers[ns_short]:
                            raise SystemExit(f"{prog}: duplicate Bundle-Name producer {assoc_prod!r} in pipeline")

        ambiguous_shorts = {s for s, owners in short_to_producers.items() if len(owners) > 1}

        for assoc_prod, kl, v in raw_vars:
            prod = assoc_prod or result.bundle_name
            if "." in kl:
                parts = [p.replace("-", "_") for p in kl.split(".")]
                if len(parts) >= 3:
                    ns_full = f"{parts[0]}.{parts[1]}"
                    ns_short = parts[1]
                    rest = ".".join(parts[2:])
                    full_var = f"{ns_full}.{rest}"
                    if _VAR_RE.fullmatch(full_var):
                        result.vars[full_var] = v
                    if ns_short not in ambiguous_shorts:
                        short_var = f"{ns_short}.{rest}"
                        if _VAR_RE.fullmatch(short_var):
                            result.vars[short_var] = v
                else:
                    ns = parts[0]
                    rest = ".".join(parts[1:])
                    if ns not in ambiguous_shorts:
                        var_name = f"{ns}.{rest}"
                        if _VAR_RE.fullmatch(var_name):
                            result.vars[var_name] = v
            else:
                key_norm = kl.replace("-", "_")
                if prod:
                    full_var = f"{prod}.{key_norm}"
                    if _VAR_RE.fullmatch(full_var):
                        result.vars[full_var] = v
                    p_short = prod.rsplit(".", 1)[-1]
                    if p_short != prod and p_short not in ambiguous_shorts:
                        short_var = f"{p_short}.{key_norm}"
                        if _VAR_RE.fullmatch(short_var):
                            result.vars[short_var] = v
                else:
                    if _VAR_RE.fullmatch(key_norm):
                        result.vars[key_norm] = v

        raw = "\n".join(lines[idx:]).strip()
        lines = raw.splitlines()

    if result.boundary:
        result.fragments, result.prompt = extract_fragments(raw, result.boundary)
        return result
    if len(lines) == 1 and re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", lines[0].strip()):
        token = lines[0].strip()
        if result.bundle_name:
            result.vars.setdefault(f"{result.bundle_name}.task", token)
            p_short = result.bundle_name.rsplit(".", 1)[-1]
            if p_short != result.bundle_name and p_short not in ambiguous_shorts:
                result.vars.setdefault(f"{p_short}.task", token)
        else:
            result.vars.setdefault("task", token)
        return result
    result.prompt = raw
    return result


def meta_chain(meta: dict[str, object]) -> list[str]:
    raw = meta.get("chain")
    return [str(c) for c in raw] if isinstance(raw, list) else []


def strip_section_header(content: str, header: str) -> str:
    """Drop a leading section header line from fragment content."""
    if content == header:
        return ""
    prefix = header + "\n"
    return content[len(prefix) :] if content.startswith(prefix) else content


def default_spec_template(prog: str | None = None) -> str:
    cmd = prog or prog_name()
    lines = [
        f"# {SPEC_FILE_NAME} — root context bundle for '{cmd}'",
        "# Directives:",
        "#   bundle <owner>/<repo>[:<name>] [allow=<cmd,...>] [key=val ...]",
        "#   rule <owner>/<repo>:<name...> [key=val ...]",
        "#   file <path|glob|slice...>  (or file $(<shell command>))",
        "#   cmd <shell command>",
        "#   prompt <text>",
        "#   let <name>=<value>  (or let <name>=$(<shell command>); bundle-scoped)",
        "#   export <name...>  (promote to session scope and output preamble)",
        "#   if <cond> / else if <cond> / else  (4-space indented blocks)",
        "#   allow <bin...>  (permit external bundles to run listed executables)",
        "",
        f"bundle {DEFAULT_RULES_PKG}:default",
        "",
        "file AGENTS.md",
        f"cmd {cmd} --tree",
        "cmd git status -sb",
        "cmd git branch -vv",
        "cmd git log --oneline -10",
        "",
    ]
    return "\n".join(lines)


def cmd_init(force: bool = False, target_dir: Path | None = None) -> int:
    prog = prog_name()
    base_dir = (target_dir if target_dir is not None else Path.cwd()).resolve()
    path = base_dir / SPEC_FILE_NAME
    if path.exists() and not force:
        sys.stderr.write(f"{prog}: {path} already exists (use --force to overwrite)\n")
        return 2
    path.write_text(default_spec_template(prog), encoding="utf-8")
    sys.stdout.write(f"{prog}: wrote starter {SPEC_FILE_NAME} to {path}\n")
    return 0


def _normalize_header_name(raw_key: str) -> str:
    segments = []
    for dot_part in raw_key.strip().split("."):
        parts = [part.capitalize() for part in re.split(r"[-_]+", dot_part) if part]
        if parts:
            segments.append("-".join(parts))
    return ".".join(segments)


def _parse_export_keys(raw_args: str, source_label: str, prog: str) -> list[str]:
    tokens = [tok for tok in re.split(r"[\s,]+", raw_args.strip()) if tok]
    keys: list[str] = []
    for tok in tokens:
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_.-]*", tok):
            raise SystemExit(f"{prog}: invalid variable name {tok!r} in {source_label}")
        norm = tok.lower().replace("-", "_")
        if norm and norm not in keys:
            keys.append(norm)
    return keys


def env_plain() -> bool:
    raw = os.environ.get("CONTEXT_BUNDLE_PLAIN", "").strip().lower()
    return raw in ("1", "true", "yes", "on")


def find_spec_file(start_dir: Path | None = None) -> Path | None:
    cur = (start_dir if start_dir is not None else Path.cwd()).resolve()
    for name in (SPEC_FILE_NAME, LEGACY_SPEC_FILE_NAME):
        candidate = cur / name
        if candidate.is_file():
            return candidate
    return None


_SHELL_WRAPPER_BINS = {"command", "builtin", "exec", "nohup", "time", "env", "nice"}


def _parse_allow_bins(raw_args: str, source_label: str, prog: str) -> list[str]:
    tokens = [tok for tok in re.split(r"[\s,]+", raw_args.strip()) if tok]
    if not tokens:
        raise SystemExit(f"{prog}: empty allow list in {source_label}")
    bins: list[str] = []
    for tok in tokens:
        if not re.fullmatch(r"[A-Za-z0-9_./+-]+", tok):
            raise SystemExit(f"{prog}: invalid command name {tok!r} in {source_label}")
        if tok not in bins:
            bins.append(tok)
    return bins


def _extract_subshells_and_segments(cmd_str: str) -> list[str]:
    segments: list[str] = []
    subshells: list[str] = []
    buf: list[str] = []
    in_single = False
    in_double = False
    escaped = False
    i = 0
    n = len(cmd_str)
    while i < n:
        ch = cmd_str[i]
        if escaped:
            buf.append(ch)
            escaped = False
            i += 1
            continue
        if ch == "\\" and not in_single:
            escaped = True
            buf.append(ch)
            i += 1
            continue
        if ch == "'" and not in_double:
            in_single = not in_single
            buf.append(ch)
            i += 1
            continue
        if ch == '"' and not in_single:
            in_double = not in_double
            buf.append(ch)
            i += 1
            continue
        if not in_single and ch == "$" and i + 1 < n and cmd_str[i + 1] == "(":
            depth = 1
            j = i + 2
            sub_s = False
            sub_d = False
            sub_esc = False
            while j < n and depth > 0:
                c2 = cmd_str[j]
                if sub_esc:
                    sub_esc = False
                elif c2 == "\\" and not sub_s:
                    sub_esc = True
                elif c2 == "'" and not sub_d:
                    sub_s = not sub_s
                elif c2 == '"' and not sub_s:
                    sub_d = not sub_d
                elif not sub_s and not sub_d:
                    if c2 == "(":
                        depth += 1
                    elif c2 == ")":
                        depth -= 1
                j += 1
            inner = cmd_str[i + 2 : j - 1 if depth == 0 else j].strip()
            if inner:
                subshells.append(inner)
            buf.append("__SUBSHELL__")
            i = j
            continue
        if not in_single and ch == "`":
            j = i + 1
            sub_esc = False
            while j < n:
                c2 = cmd_str[j]
                if sub_esc:
                    sub_esc = False
                elif c2 == "\\":
                    sub_esc = True
                elif c2 == "`":
                    break
                j += 1
            inner = cmd_str[i + 1 : j].strip()
            if inner:
                subshells.append(inner)
            buf.append("__SUBSHELL__")
            i = min(n, j + 1)
            continue
        if not in_single and not in_double:
            if cmd_str[i : i + 2] in ("&&", "||"):
                seg = "".join(buf).strip()
                if seg:
                    segments.append(seg)
                buf = []
                i += 2
                continue
            if ch in ("|", ";", "&", "\n"):
                seg = "".join(buf).strip()
                if seg:
                    segments.append(seg)
                buf = []
                i += 1
                continue
        buf.append(ch)
        i += 1
    tail = "".join(buf).strip()
    if tail:
        segments.append(tail)
    for sub in subshells:
        segments.extend(_extract_subshells_and_segments(sub))
    return segments


def _extract_command_executables(cmd_str: str) -> list[str]:
    exes: list[str] = []
    for raw_seg in _extract_subshells_and_segments(cmd_str):
        seg = raw_seg.strip()
        while seg and seg[0] in ("(", "{", "!"):
            seg = seg[1:].strip()
        while seg and seg[-1] in (")", "}"):
            seg = seg[:-1].strip()
        if not seg or seg.startswith("#"):
            continue
        try:
            tokens = shlex.split(seg, posix=True)
        except ValueError:
            tokens = seg.split()
        idx = 0
        while idx < len(tokens):
            tok = tokens[idx].lstrip("({!").rstrip(")}")
            if not tok or tok in ("!", "(", ")", "{", "}"):
                idx += 1
                continue
            if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", tok, flags=re.DOTALL):
                idx += 1
                continue
            if tok != "__SUBSHELL__":
                exes.append(tok)
            if tok in _SHELL_WRAPPER_BINS:
                idx += 1
                if tok == "command" and idx < len(tokens) and tokens[idx] in ("-v", "-V"):
                    break
                while idx < len(tokens) and (
                    tokens[idx].startswith("-")
                    or re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", tokens[idx], flags=re.DOTALL)
                ):
                    idx += 1
                continue
            break
    return exes


def _check_command_allowed(
    cmd_str: str,
    allowed_cmds: set[str],
    bundle_label: str,
    prog: str,
) -> None:
    exes = _extract_command_executables(cmd_str)
    for exe in exes:
        if exe not in allowed_cmds:
            raise SystemExit(
                f"{prog}: command {cmd_str!r} (executable {exe!r}) in external bundle "
                f"{bundle_label!r} is not in allowlist (add 'allow {exe}' in {SPEC_FILE_NAME} "
                f"or 'bundle {bundle_label} allow={exe}')"
            )


def _eval_dynamic_expr(
    expr: str,
    work_dir: Path | None = None,
    allowed_cmds: set[str] | None = None,
    bundle_label: str | None = None,
    prog: str | None = None,
) -> str:
    s = expr.strip()
    if s.startswith("$(") and s.endswith(")") and len(s) >= 3:
        cmd = s[2:-1].strip()
        if not cmd:
            return ""
        if allowed_cmds is not None:
            _check_command_allowed(cmd, allowed_cmds, bundle_label or SPEC_FILE_NAME, prog or prog_name())
        cwd = (work_dir if work_dir is not None else Path.cwd()).resolve()
        rc, out, _ = _run_spec_command(cmd, cwd)
        if rc != 0:
            return ""
        return out.strip()
    return s


def _split_file_items(raw_expr: str, is_dynamic: bool) -> list[str]:
    if not raw_expr.strip():
        return []
    if is_dynamic and "\n" in raw_expr:
        return [ln.strip() for ln in raw_expr.splitlines() if ln.strip()]
    try:
        return [tok.strip() for tok in shlex.split(raw_expr) if tok.strip()]
    except ValueError:
        return [tok.strip() for tok in raw_expr.split() if tok.strip()]


def _qualify_nested_target(
    target: str,
    work_dir: Path | None,
    bundle_dir: Path | None,
    default_pkg: str | None,
    pkg_dir: Path | None,
    prog: str,
) -> str:
    if _is_local_path_spec(target) and not Path(target).expanduser().is_absolute():
        if default_pkg is not None and pkg_dir is not None and bundle_dir is not None:
            resolved = (bundle_dir / target).resolve()
            try:
                rel = resolved.relative_to(pkg_dir.resolve())
            except ValueError:
                raise SystemExit(f"{prog}: package path escapes package root: {target}")
            return f"{default_pkg}:{rel.as_posix()}"
        if bundle_dir is not None and work_dir is not None and bundle_dir.resolve() != work_dir.resolve():
            return (bundle_dir / target).resolve().as_posix()
    elif (
        ":" not in target
        and not target.startswith(("http://", "https://", "file://"))
        and default_pkg is not None
    ):
        return f"{default_pkg}:{target}"
    return target


def _static_inspect_bundle_ast(
    nodes: list[tuple[str, object]],
    bvars: dict[str, str],
    allowed_cmds: set[str],
    bundle_label: str,
    root_label: str,
    prog: str,
) -> None:
    sim_vars = dict(bvars)

    def walk(stmts: list[tuple[str, object]]) -> None:
        for n_kind, payload in stmts:
            if n_kind == "if_chain":
                for b_cond, _b_trace, b_body in payload:  # type: ignore[misc]
                    if b_cond is None or eval_if_condition(b_cond, sim_vars, prog):
                        walk(b_body)
                        break
                continue
            raw_line = str(payload)
            line = _render_rule_vars(raw_line, sim_vars).strip()
            if line == "allow" or line.startswith("allow "):
                raise SystemExit(
                    f"{prog}: 'allow' directive is only permitted in root {root_label} "
                    f"(found in bundle {bundle_label!r}: {line!r})"
                )
            if line.startswith("cmd "):
                cmd_str = line[4:].strip()
                if cmd_str:
                    _check_command_allowed(cmd_str, allowed_cmds, bundle_label, prog)
            elif line.startswith("let "):
                assign = line[4:].strip()
                if "=" in assign:
                    k, v_expr = assign.split("=", 1)
                    k_clean = k.strip()
                    s = v_expr.strip()
                    if s.startswith("$(") and s.endswith(")") and len(s) >= 3:
                        cmd_str = s[2:-1].strip()
                        if cmd_str:
                            _check_command_allowed(cmd_str, allowed_cmds, bundle_label, prog)
                    elif not sim_vars.get(k_clean) and s:
                        sim_vars[k_clean] = s
            elif line.startswith("file "):
                inc_expr = line[5:].strip()
                if inc_expr.startswith("$(") and inc_expr.endswith(")") and len(inc_expr) >= 3:
                    cmd_str = inc_expr[2:-1].strip()
                    if cmd_str:
                        _check_command_allowed(cmd_str, allowed_cmds, bundle_label, prog)

    walk(nodes)


def parse_spec(
    text: str,
    work_dir: Path | None = None,
    cli_vars: dict[str, str] | None = None,
    refresh: bool = False,
    resolved_vars: dict[str, str] | None = None,
    piped: bool = False,
    chain: list[str] | None = None,
    active_bundles: list[tuple[str, str]] | None = None,
    default_pkg: str | None = None,
    pkg_dir: Path | None = None,
    bundle_dir: Path | None = None,
    is_external: bool = False,
    allowed_cmds: set[str] | None = None,
    enforce_allowlist: bool = True,
    external_chains: dict[tuple[str, ...], tuple[str, set[str] | None]] | None = None,
    session_vars: dict[str, str] | None = None,
) -> list[tuple[str, str, str | None, list[str]]]:
    prog = prog_name()
    caller_vars: dict[str, str] = dict(cli_vars) if cli_vars is not None else {}
    active_vars: dict[str, str] = dict(caller_vars)
    bvars = {**builtin_vars(work_dir, piped=piped), **active_vars}
    cur_chain = list(chain) if chain else []
    cur_bdir = bundle_dir if bundle_dir is not None else work_dir
    root_label = (
        cur_chain[0]
        if (cur_chain and cur_chain[0] in (SPEC_FILE_NAME, LEGACY_SPEC_FILE_NAME))
        else SPEC_FILE_NAME
    )
    in_child_bundle = bool(cur_chain and cur_chain != [root_label])
    bundle_label = cur_chain[-1] if in_child_bundle else root_label
    cur_allowed: set[str] = set(allowed_cmds) if allowed_cmds is not None else set()
    ast_nodes = parse_bundle_ast(text, prog)

    if is_external and enforce_allowlist and in_child_bundle:
        _static_inspect_bundle_ast(ast_nodes, bvars, cur_allowed, bundle_label, root_label, prog)

    effective_allow_set: set[str] | None = cur_allowed if (is_external and enforce_allowlist) else None
    if is_external and external_chains is not None:
        external_chains[tuple(cur_chain)] = (
            bundle_label,
            set(cur_allowed) if effective_allow_set is not None else None,
        )

    entries: list[tuple[str, str, str | None, list[str]]] = []
    local_exports: list[str] = []

    def promote_export(var_key: str) -> None:
        if var_key not in local_exports:
            local_exports.append(var_key)
        val = active_vars.get(var_key, "")
        if val:
            if session_vars is not None:
                session_vars[var_key] = val
            if resolved_vars is not None:
                resolved_vars[var_key] = val

    def exec_nodes(nodes: list[tuple[str, object]], cond_stack: list[str]) -> None:
        for n_kind, payload in nodes:
            if n_kind == "if_chain":
                for b_cond, b_trace, b_body in payload:  # type: ignore[misc]
                    if b_cond is None or eval_if_condition(b_cond, bvars, prog):
                        exec_nodes(b_body, [*cond_stack, b_trace])
                        break
                continue
            raw_line = str(payload)
            cond_expr = " ".join(c for c in cond_stack if c and c != "else") or None
            line = _render_rule_vars(raw_line, bvars).strip()
            if not line:
                continue
            if line == "allow" or line.startswith("allow "):
                if in_child_bundle:
                    raise SystemExit(
                        f"{prog}: 'allow' directive is only permitted in root {root_label} "
                        f"(found in bundle {bundle_label!r}: {line!r})"
                    )
                if line == "allow":
                    raise SystemExit(f"{prog}: empty allow list in {root_label}")
                cur_allowed.update(_parse_allow_bins(line[len("allow ") :], root_label, prog))
            elif line == "let" or line.startswith("let "):
                assign = line[len("let") :].strip()
                if "=" not in assign:
                    raise SystemExit(
                        f"{prog}: invalid let directive in {bundle_label}: {line!r} (expected 'let key=val')"
                    )
                k, v_expr = assign.split("=", 1)
                k_clean = k.strip()
                if not VAR_NAME_RE.fullmatch(k_clean):
                    raise SystemExit(f"{prog}: invalid variable name {k_clean!r} in {line!r}")
                if not active_vars.get(k_clean):
                    val = _eval_dynamic_expr(
                        v_expr,
                        work_dir=work_dir,
                        allowed_cmds=effective_allow_set,
                        bundle_label=bundle_label,
                        prog=prog,
                    )
                    if val:
                        active_vars[k_clean] = val
                        bvars[k_clean] = val
                        if k_clean in local_exports:
                            if session_vars is not None:
                                session_vars[k_clean] = val
                            if resolved_vars is not None:
                                resolved_vars[k_clean] = val
            elif line == "file" or line.startswith("file "):
                inc_expr = line[len("file") :].strip()
                if not inc_expr:
                    continue
                is_dyn = inc_expr.startswith("$(") and inc_expr.endswith(")") and len(inc_expr) >= 3
                resolved_inc = _eval_dynamic_expr(
                    inc_expr,
                    work_dir=work_dir,
                    allowed_cmds=effective_allow_set,
                    bundle_label=bundle_label,
                    prog=prog,
                )
                for clean_item in _split_file_items(resolved_inc, is_dyn):
                    if is_external and work_dir is not None:
                        _expand_include(work_dir, clean_item, root_dir=work_dir, bundle_label=bundle_label)
                    entries.append(("file", clean_item, cond_expr, list(cur_chain)))
            elif line == "cmd" or line.startswith("cmd "):
                cmd_str = line[len("cmd") :].strip()
                if cmd_str:
                    if effective_allow_set is not None:
                        _check_command_allowed(cmd_str, effective_allow_set, bundle_label, prog)
                    entries.append(("cmd", cmd_str, cond_expr, list(cur_chain)))
            elif line == "rule" or line.startswith("rule "):
                parts = shlex.split(line)
                targets, vmap = _parse_rule_directive_tokens(parts[1:], prog)
                eff_vmap = {**active_vars, **vmap, **caller_vars}
                var_tokens = [f"{k}={v}" for k, v in eff_vmap.items()]
                for tgt in targets:
                    new_tgt = _qualify_nested_target(tgt, work_dir, cur_bdir, default_pkg, pkg_dir, prog)
                    single_line = shlex.join(["rule", new_tgt, *var_tokens])
                    entries.append(("directive", single_line, cond_expr, list(cur_chain)))
            elif line == "bundle" or line.startswith("bundle "):
                parts = shlex.split(line)
                target, _excls, vmap = _parse_directive_tokens(parts[1:], prog)
                bundle_allow_raw = vmap.pop("allow", None)
                child_allowed = set(cur_allowed)
                child_enforce = enforce_allowlist
                if bundle_allow_raw is not None:
                    parsed_bins = set(_parse_allow_bins(bundle_allow_raw, f"bundle {target}", prog))
                    if is_external and enforce_allowlist:
                        disallowed = sorted(parsed_bins - cur_allowed)
                        if disallowed:
                            raise SystemExit(
                                f"{prog}: external bundle {bundle_label!r} cannot grant allow={','.join(disallowed)!r} "
                                f"to child bundle {target!r}"
                            )
                        child_allowed = cur_allowed & parsed_bins
                    else:
                        child_allowed.update(parsed_bins)
                        child_enforce = True
                lookup_target = _qualify_nested_target(target, work_dir, cur_bdir, default_pkg, pkg_dir, prog)
                canonical_bundle, inc_text, child_pkg, child_pkg_dir, child_bdir = _resolve_bundle_context(
                    lookup_target,
                    work_dir=cur_bdir,
                    refresh=refresh,
                    default_pkg=default_pkg or DEFAULT_RULES_PKG,
                )
                cur_active = list(active_bundles) if active_bundles else []
                if any(cid == canonical_bundle for cid, _ in cur_active):
                    cycle_path = " -> ".join([*(lbl for _, lbl in cur_active), target])
                    raise SystemExit(f"{prog}: circular bundle reference detected: {cycle_path}")
                child_is_external = _is_external_bundle_source(
                    canonical_bundle,
                    child_pkg,
                    child_bdir,
                    work_dir,
                    parent_is_external=is_external,
                )
                merged_cli = {**active_vars, **vmap, **caller_vars}
                sub_resolved: dict[str, str] = {}
                child_chain_label = (
                    lookup_target
                    if (default_pkg is not None and ":" not in target and not _is_local_path_spec(target))
                    else target
                )
                child_chain = [*cur_chain, child_chain_label]
                for sub_kind, sub_val, sub_cond, sub_chain in parse_spec(
                    inc_text,
                    work_dir=work_dir,
                    cli_vars=merged_cli,
                    refresh=refresh,
                    resolved_vars=sub_resolved,
                    piped=piped,
                    chain=child_chain,
                    active_bundles=[*cur_active, (canonical_bundle, target)],
                    default_pkg=child_pkg,
                    pkg_dir=child_pkg_dir,
                    bundle_dir=child_bdir,
                    is_external=child_is_external,
                    allowed_cmds=child_allowed,
                    enforce_allowlist=child_enforce,
                    external_chains=external_chains,
                    session_vars=session_vars,
                ):
                    comb_cond = " ".join(c for c in (cond_expr, sub_cond) if c) or None
                    entries.append((sub_kind, sub_val, comb_cond, sub_chain))
                for rk, rv in sub_resolved.items():
                    if not active_vars.get(rk):
                        active_vars[rk] = rv
                        bvars[rk] = rv
                        if resolved_vars is not None:
                            resolved_vars[rk] = rv
                        if session_vars is not None:
                            session_vars[rk] = rv
            elif line == "export" or line.startswith("export "):
                exp_raw = line[len("export") :].strip()
                if not exp_raw:
                    continue
                for var_key in _parse_export_keys(exp_raw, bundle_label, prog):
                    promote_export(var_key)
                    entries.append(("export", var_key, cond_expr, list(cur_chain)))
            elif line == "prompt" or line.startswith("prompt "):
                p_str = line[len("prompt") :].strip()
                if p_str:
                    entries.append(("prompt", p_str, cond_expr, list(cur_chain)))
            else:
                raise SystemExit(
                    f"{prog}: invalid line in {bundle_label}: {line!r} (expected 'bundle ...', 'rule ...', "
                    f"'file ...', 'cmd ...', 'prompt ...', 'let ...', 'export ...', 'if ...', or 'allow ...')"
                )

    exec_nodes(ast_nodes, [])
    return entries


def _run_spec_command(cmd_str: str, cwd: Path) -> tuple[int, str, int]:
    t0 = time.monotonic()
    prog = prog_name()
    self_dir = str(Path(__file__).resolve().parent)
    if re.match(rf"^(?:{re.escape(prog)}|context|agents_bundle)\s+--tree(?:\s+.*)?$", cmd_str):
        try:
            parts = shlex.split(cmd_str)[2:]
            out = _tree_from_args(parts, default_dir=cwd).rstrip()
            elapsed_ms = max(0, int(round((time.monotonic() - t0) * 1000)))
            return 0, out, elapsed_ms
        except SystemExit as exc:
            elapsed_ms = max(0, int(round((time.monotonic() - t0) * 1000)))
            return 1, str(exc), elapsed_ms

    shell_bin = os.environ.get("CONTEXT_BUNDLE_SHELL", "").strip() or "bash"
    env = {**os.environ, "PYTHONUTF8": "1"}
    env["PATH"] = f"{self_dir}{os.pathsep}{Path.home() / '.local/bin'}{os.pathsep}{env.get('PATH', '')}"
    try:
        r = subprocess.run(
            [shell_bin, "-c", cmd_str],
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=env,
            check=False,
        )
        elapsed_ms = max(0, int(round((time.monotonic() - t0) * 1000)))
        return r.returncode, r.stdout.decode("utf-8", errors="replace").rstrip(), elapsed_ms
    except OSError as exc:
        elapsed_ms = max(0, int(round((time.monotonic() - t0) * 1000)))
        return 1, f"[error running {cmd_str!r}: {exc}]", elapsed_ms


def build_bundle(
    work_dir: Path | None = None,
    extra_files: list[str] | None = None,
    prompt_text: str | None = None,
    refresh: bool = False,
    verbose: bool = False,
    cli_vars: dict[str, str] | None = None,
    raw_argv: list[str] | None = None,
    piped: bool = False,
    records: list[dict[str, object]] | None = None,
    plain: bool = False,
    spec_text: str | None = None,
    upstream: PipedInput | None = None,
) -> tuple[str, list[str]]:
    prog = prog_name()
    if work_dir is not None:
        resolved_wdir = work_dir.resolve()
        if not resolved_wdir.exists():
            sys.stderr.write(f"{prog}: directory not found: {work_dir}\n")
            raise SystemExit(2)
        if not resolved_wdir.is_dir():
            sys.stderr.write(f"{prog}: not a directory: {work_dir}\n")
            raise SystemExit(2)
        wdir = resolved_wdir
    else:
        wdir = Path.cwd().resolve()
    spec_file = find_spec_file(wdir) if spec_text is None else None
    if spec_text is None and spec_file is None:
        sys.stderr.write(
            f"{prog}: {SPEC_FILE_NAME} or {LEGACY_SPEC_FILE_NAME} not found in {wdir} "
            f"(run '{prog} --init' to create a starter template)\n"
        )
        raise SystemExit(2)

    if spec_file is not None:
        spec_dir = spec_file.parent
        spec_source = spec_file.read_text(encoding="utf-8")
        spec_label = spec_file.name
        root_bundles = [(str(spec_file.resolve()), spec_label)]
    else:
        spec_dir = wdir
        spec_source = spec_text or ""
        spec_label = SPEC_FILE_NAME
        root_bundles = []
    effective_cli_vars: dict[str, str] = dict(cli_vars or {})
    cli_allow_raw = effective_cli_vars.pop("allow", None) if spec_file is None else None
    init_allowed: set[str] | None = (
        set(_parse_allow_bins(cli_allow_raw, "allow", prog)) if cli_allow_raw is not None else None
    )
    enforce_allowlist = spec_file is not None or cli_allow_raw is not None
    external_chains: dict[tuple[str, ...], tuple[str, set[str] | None]] = {}
    session_vars: dict[str, str] = dict(effective_cli_vars)
    resolved_vars: dict[str, str] = {}
    entries = parse_spec(
        spec_source,
        work_dir=spec_dir,
        cli_vars=effective_cli_vars,
        refresh=refresh,
        resolved_vars=resolved_vars,
        piped=piped,
        chain=[spec_label] if spec_file is not None else None,
        active_bundles=root_bundles,
        allowed_cmds=init_allowed,
        enforce_allowlist=enforce_allowlist,
        external_chains=external_chains,
        session_vars=session_vars,
    )
    session_vars.update(resolved_vars)
    boundary = secrets.token_hex(16)
    fragment_boundary = None if plain else boundary
    section_blocks: list[str] = []
    warnings: list[str] = []
    pending_rules: list[tuple[str, str, str, list[str]]] = []
    middle_items: list[tuple[str, object]] = []
    spec_prompts: list[tuple[str, list[str]]] = []
    spec_exports: list[str] = []
    up_groups: dict[str, list[tuple[dict[str, object], str]]] = {
        "rules": [],
        "cmds": [],
        "files": [],
        "prompts": [],
    }
    rule_vars = {**builtin_vars(spec_dir, piped=piped), **session_vars}

    def normalize_rule_body(raw_body: str, name: str) -> str:
        return _render_rule_vars(_parse_md_text(raw_body, name)[1], rule_vars).strip()

    if upstream is not None:
        up_groups, unknown_kinds = group_fragments(upstream.fragments)
        for unknown in unknown_kinds:
            warnings.append(f"ignored upstream fragment of unknown kind: {unknown}")
        for up_meta, up_body in up_groups["rules"]:
            up_uid = str(up_meta.get("id") or "")
            if not up_uid:
                warnings.append("ignored upstream rule fragment without id")
                continue
            up_rendered = normalize_rule_body(up_body, up_uid)
            if up_rendered:
                pending_rules.append((up_uid, f"# [upstream rule {up_uid}]", up_rendered, meta_chain(up_meta)))
        for up_meta, up_content in up_groups["cmds"]:
            middle_items.append(("up_cmd", (dict(up_meta), up_content)))
        for up_meta, up_content in up_groups["files"]:
            middle_items.append(("span", span_from_fragment(up_meta, up_content, wdir)))

    for kind, val, cond_expr, entry_chain in entries:
        if kind == "directive":
            parts = shlex.split(val)
            d_kind = parts[0]
            target, excls, vmap = _parse_directive_tokens(parts[1:], prog)
            base_trace = f"if {cond_expr} {d_kind} {target}" if cond_expr else f"{d_kind} {target}"
            trace_chain = [b for b in entry_chain if b not in (SPEC_FILE_NAME, LEGACY_SPEC_FILE_NAME)]
            trace_prefix = [*(f"bundle {b}" for b in trace_chain), base_trace]
            merged_vmap = {**vmap, **session_vars}
            pending_rules.extend(
                collect_directive_items(
                    d_kind,
                    target,
                    excludes=excls,
                    cli_vars=merged_vmap,
                    work_dir=spec_dir,
                    refresh=refresh,
                    trace_prefix=trace_prefix,
                    piped=piped,
                    chain=entry_chain,
                )
            )
        elif kind == "cmd":
            ext_policy = external_chains.get(tuple(entry_chain))
            if ext_policy is not None and ext_policy[1] is not None:
                _check_command_allowed(val, ext_policy[1], ext_policy[0], prog)
            middle_items.append(("cmd", (val, list(entry_chain))))
        elif kind == "export":
            if val not in spec_exports:
                spec_exports.append(val)
        elif kind == "file":
            clean = val.strip()
            if not clean:
                continue
            ext_policy = external_chains.get(tuple(entry_chain))
            slices = _expand_include(
                wdir,
                clean,
                root_dir=spec_dir if ext_policy is not None else None,
                bundle_label=ext_policy[0] if ext_policy is not None else None,
            )
            for p, start, end in slices:
                middle_items.append(("span", read_span(p, display_path(p, spec_dir), start, end, entry_chain)))
        elif kind == "prompt":
            spec_prompts.append((val, entry_chain))

    for extra in extra_files or []:
        clean = extra.strip()
        if not clean:
            continue
        slices = _expand_include(wdir, clean)
        if not slices:
            warnings.append(f"missing file: {clean}")
            continue
        for p, start, end in slices:
            middle_items.append(("span", read_span(p, display_path(p, spec_dir), start, end, [])))

    pending_rules = [
        r for r in pending_rules
        if r[0] not in (LEGACY_RULE_ID, EMBEDDED_RULE_ID, "agents_bundle", EMBEDDED_RULE_NAME)
    ]
    embedded = normalize_rule_body(embedded_rule_text(), EMBEDDED_RULE_ID)
    if embedded:
        pending_rules.append(
            (EMBEDDED_RULE_ID, f"# [embedded rule {EMBEDDED_RULE_ID}]", embedded, [PRODUCER_NAME])
        )

    if pending_rules:
        formatted = format_collected_rules(pending_rules, verbose=verbose, boundary=fragment_boundary).strip()
        if formatted:
            section_blocks.append(f"{RULES_HEADER}\n{formatted}\n")
            if records is not None:
                seen_rule_uids: set[str] = set()
                for r_uid, _r_prov, _r_body, r_chain in pending_rules:
                    if r_uid in seen_rule_uids:
                        continue
                    seen_rule_uids.add(r_uid)
                    records.append(
                        {
                            "kind": "rule",
                            "id": r_uid,
                            "chain": list(r_chain),
                        }
                    )

    raw_spans: list[IncludeSpan] = [item[1] for item in middle_items if item[0] == "span"]  # type: ignore[misc]
    merged_span_list = merge_spans(raw_spans)
    merged_by_id = {id(s): s for s in merged_span_list}
    # Map each first-occurrence key/range position to the surviving merged span
    surviving_spans = list(merged_span_list)
    used_merged: set[int] = set()

    for m_kind, m_payload in middle_items:
        if m_kind == "up_cmd":
            up_meta, up_content = m_payload  # type: ignore[misc]
            wrapped_up = wrap_bundle_fragment(fragment_boundary, dict(up_meta), up_content)
            section_blocks.append(f"{wrapped_up}\n")
            if records is not None:
                records.append(dict(up_meta))
        elif m_kind == "cmd":
            cmd_val, cmd_chain = m_payload  # type: ignore[misc]
            rc, out, elapsed_ms = _run_spec_command(cmd_val, spec_dir)
            if rc != 0:
                warnings.append(f"command exited {rc}: {cmd_val}")
            cmd_meta: dict[str, object] = {
                "kind": "cmd",
                "name": cmd_val,
                "chain": list(cmd_chain),
                "rc": rc,
                "ms": elapsed_ms,
            }
            wrapped_cmd = wrap_bundle_fragment(fragment_boundary, cmd_meta, f"===== $ {cmd_val} =====\n{out}")
            section_blocks.append(f"{wrapped_cmd}\n")
            if records is not None:
                records.append(cmd_meta)
        elif m_kind == "span":
            orig_span: IncludeSpan = m_payload  # type: ignore[assignment]
            chosen: IncludeSpan | None = None
            if id(orig_span) in merged_by_id and id(orig_span) not in used_merged:
                chosen = orig_span
            else:
                for cand in surviving_spans:
                    if id(cand) not in used_merged and cand.key == orig_span.key:
                        if cand.whole_text is not None or (
                            orig_span.start is not None
                            and orig_span.end is not None
                            and cand.start is not None
                            and cand.end is not None
                            and cand.start <= orig_span.end
                            and orig_span.start <= cand.end
                        ):
                            chosen = cand
                            break
            if chosen is None:
                continue
            used_merged.add(id(chosen))
            inc_meta, inc_text = render_span(chosen)
            wrapped_inc = wrap_bundle_fragment(fragment_boundary, inc_meta, inc_text)
            section_blocks.append(f"{wrapped_inc}\n")
            if records is not None:
                records.append(inc_meta)

    all_prompt_items = [*spec_prompts]
    if prompt_text and prompt_text.strip():
        all_prompt_items.append((prompt_text.strip(), []))
    prompt_frags: list[tuple[dict[str, object], str]] = [
        (dict(m), strip_section_header(c, PROMPT_HEADER)) for m, c in up_groups["prompts"]
    ]
    n_upstream_prompts = len(prompt_frags)
    if all_prompt_items:
        first_chain = all_prompt_items[0][1]
        shared_chain = list(first_chain) if all(p_chain == first_chain for _p_text, p_chain in all_prompt_items) else []
        prompt_meta: dict[str, object] = {
            "kind": "prompt",
            "chain": shared_chain,
        }
        prompt_frags.append((prompt_meta, "\n\n".join(text for text, _ in all_prompt_items)))
    if prompt_frags:
        wrapped_parts = [
            wrap_bundle_fragment(fragment_boundary, meta, f"{PROMPT_HEADER}\n{body}" if idx == 0 else body)
            for idx, (meta, body) in enumerate(prompt_frags)
        ]
        section_blocks.append(("\n" if fragment_boundary else "\n\n").join(wrapped_parts) + "\n")
        if records is not None:
            for meta, _body in prompt_frags[:n_upstream_prompts]:
                records.append(dict(meta))
            for _p_text, p_chain in all_prompt_items:
                records.append(
                    {
                        "kind": "prompt",
                        "chain": list(p_chain),
                    }
                )

    header_lines: list[str] = []
    if not plain:
        cmd_line = shlex.join([prog, *raw_argv]) if raw_argv else prog
        if upstream is not None and upstream.command:
            cmd_line = f"{upstream.command} | {cmd_line}"
        header_lines.extend(
            [
                f"Bundle-Command: {cmd_line}",
                f"Bundle-Name: {PRODUCER_NAME}",
                f"Bundle-Boundary: {boundary}",
                f"Bundle-Protocol: {PROTOCOL_VERSION}",
            ]
        )
    for exp_key in spec_exports:
        if exp_key == "workdir":
            continue
        val = session_vars.get(exp_key, "")
        if val != "":
            hdr_key = _normalize_header_name(exp_key)
            header_lines.append(f"{hdr_key}: {val}")
    header_lines.append(f"Workdir: {wdir}")
    header = "\n".join(header_lines) + "\n"
    blocks = [header, *section_blocks]
    return "\n".join(blocks), warnings


def _stdin_is_fifo() -> bool:
    try:
        return stat.S_ISFIFO(os.fstat(sys.stdin.fileno()).st_mode)
    except (AttributeError, OSError, ValueError):
        return False


def cmd_bundle(
    argv: list[str],
    bundle_target: str | None = None,
    raw_argv: list[str] | None = None,
) -> int:
    prog = prog_name()
    work_dir: Path | None = None
    prompt_parts: list[str] = []
    extra_files: list[str] = []
    cli_vars: dict[str, str] = env_vars(prog)
    refresh = False
    verbose = False
    plain = env_plain()
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--refresh":
            refresh = True
            i += 1
        elif a in ("-v", "--verbose"):
            verbose = True
            i += 1
        elif a == "--plain":
            plain = True
            i += 1
        elif a in ("-p", "--prompt"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            prompt_parts.append(argv[i + 1])
            i += 2
        elif a in ("-C", "--dir"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires a directory path")
            work_dir = Path(argv[i + 1]).expanduser()
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option: {a}")
        elif "=" in a and re.fullmatch(rf"{VAR_NAME_PATTERN}=.*", a, flags=re.DOTALL) and not Path(a).exists():
            k, v = a.split("=", 1)
            cli_vars[k.strip()] = v.strip()
            i += 1
        else:
            extra_files.append(a)
            i += 1

    piped_workdir: str | None = None
    has_piped_prompt = False
    upstream: PipedInput | None = None
    if bundle_target is None and not sys.stdin.isatty():
        try:
            piped_raw = sys.stdin.read()
        except Exception:
            piped_raw = ""
        if not piped_raw.strip() and _stdin_is_fifo():
            sys.stderr.write(f"{prog}: empty piped input on stdin (upstream command failed?)\n")
            return 2
        if piped_raw.strip():
            upstream = parse_stdin_pipe(piped_raw)
            piped_workdir = upstream.workdir
            for ik, iv in upstream.vars.items():
                if not cli_vars.get(ik):
                    cli_vars[ik] = iv
            has_piped_prompt = upstream.has_prompt
            if upstream.prompt:
                prompt_parts.insert(0, upstream.prompt)

    if work_dir is None and piped_workdir is not None:
        if not piped_workdir:
            sys.stderr.write(f"{prog}: empty Workdir in piped input\n")
            return 2
        work_dir = Path(piped_workdir).expanduser()

    prompt_text = "\n\n".join(prompt_parts) if prompt_parts else None
    body, warnings = build_bundle(
        work_dir=work_dir,
        extra_files=extra_files,
        prompt_text=prompt_text,
        refresh=refresh,
        verbose=verbose,
        cli_vars=cli_vars,
        raw_argv=raw_argv if raw_argv is not None else argv,
        piped=has_piped_prompt,
        plain=plain,
        spec_text=None if bundle_target is None else f"bundle {shlex.quote(bundle_target)}",
        upstream=upstream,
    )
    for w in warnings:
        sys.stderr.write(f"{prog}: warning: {w}\n")
    sys.stdout.write(body)
    return 0


def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    return tuple(int(p) for p in re.split(r"[^0-9]+", v) if p)


def _is_our_binary(path: Path) -> bool:
    if not path.is_file():
        return False
    try:
        head = path.read_text(encoding="utf-8", errors="ignore")[:2048]
    except OSError:
        return False
    return REPO_MARKER in head or LEGACY_REPO_MARKER in head


def _remove_legacy_binary(install_dir: Path, keep_path: Path | None = None) -> None:
    legacy = install_dir / "agents_bundle"
    if keep_path is not None and legacy.resolve() == keep_path.resolve():
        return
    if _is_our_binary(legacy):
        try:
            legacy.unlink()
        except OSError:
            pass


def fetch_remote_script(url: str | None = None) -> str:
    import urllib.request

    target_url = url or os.environ.get("CONTEXT_BUNDLE_UPDATE_URL") or DEFAULT_UPDATE_URL
    if target_url.startswith(("http://", "https://")) and "?" not in target_url:
        target_url = f"{target_url}?t={int(time.time())}"
    req = urllib.request.Request(
        target_url,
        headers={"User-Agent": f"context-bundle/{VERSION}", "Cache-Control": "no-cache"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER not in data and LEGACY_REPO_MARKER not in data:
        raise ValueError("downloaded file does not contain expected repository marker")
    ast.parse(data)
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} --update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None) -> int:
    prog = prog_name()
    self_file = Path(sys.argv[0]).resolve() if sys.argv and sys.argv[0] else Path(__file__).resolve()
    if not self_file.is_file():
        self_file = Path(__file__).resolve()
    dest = (self_file.parent / "context") if self_file.name == "agents_bundle" else self_file
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and dest == self_file and version_tuple(remote_ver) <= version_tuple(VERSION):
        _remove_legacy_binary(dest.parent, keep_path=dest)
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    _remove_legacy_binary(dest.parent, keep_path=dest)
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n")
    return 0


def cmd_uninstall() -> int:
    prog = prog_name()
    removed_bins: list[str] = []
    candidate_dirs: list[Path] = []
    env_dir = os.environ.get("CONTEXT_BUNDLE_INSTALL_DIR")
    if env_dir:
        candidate_dirs.append(Path(env_dir).expanduser())
    self_path = Path(sys.argv[0]).resolve() if sys.argv and sys.argv[0] else Path(__file__).resolve()
    is_repo_checkout = (self_path.parent / "build.py").is_file() and (self_path.parent / "src").is_dir()
    if not is_repo_checkout and self_path.parent.is_dir():
        candidate_dirs.append(self_path.parent)
    elif not env_dir:
        candidate_dirs.append(Path.home() / ".local" / "bin")

    cmd_name = os.environ.get("CONTEXT_BUNDLE_NAME") or "context"
    names = []
    for n in (cmd_name, self_path.name if not is_repo_checkout else "", "context", "agents_bundle"):
        if n and n not in names:
            names.append(n)

    seen_targets: set[Path] = set()
    for d in candidate_dirs:
        for n in names:
            target = d / n
            try:
                resolved = target.resolve()
            except OSError:
                continue
            if resolved in seen_targets:
                continue
            seen_targets.add(resolved)
            if (resolved.parent / "build.py").is_file() and (resolved.parent / "src").is_dir():
                continue
            if target.is_file():
                if not _is_our_binary(target):
                    if n == cmd_name and env_dir:
                        sys.stderr.write(f"{prog}: {target} is not a vitalio/context-bundle script\n")
                        return 1
                    continue
                try:
                    target.unlink()
                    removed_bins.append(str(target))
                except OSError as exc:
                    sys.stderr.write(f"{prog}: could not remove {target}: {exc}\n")
                    return 1

    cdir = cache_dir_path()
    removed_caches: list[str] = []
    for cache_target in (cdir, cdir.parent / "agents_bundle"):
        if cache_target.exists():
            shutil.rmtree(cache_target, ignore_errors=True)
            removed_caches.append(str(cache_target))

    details = ", ".join([*removed_bins, *removed_caches]) or "nothing to remove"
    sys.stdout.write(f"{prog}: uninstalled ({details})\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    prog = prog_name()
    if "-h" in args or "--help" in args:
        sys.stdout.write(usage_text())
        return 0
    if "-V" in args or "--version" in args:
        sys.stdout.write(f"{prog} {VERSION}\n")
        return 0
    if args and args[0] == "bundle":
        if len(args) < 2 or args[1].startswith("-"):
            raise SystemExit(
                f"{prog}: usage: {prog} bundle <pkg>[:<name>] [k=v] [-C DIR] [-p TEXT] [--plain] [-v] [--refresh]"
            )
        return cmd_bundle(args[2:], bundle_target=args[1], raw_argv=args)
    if args and args[0] == "rule":
        refresh = "--refresh" in args[1:]
        verbose = "-v" in args[1:] or "--verbose" in args[1:]
        rest_tokens = [a for a in args[1:] if a not in ("--refresh", "-v", "--verbose")]
        targets, vmap = _parse_rule_directive_tokens(rest_tokens, prog)
        merged_vmap = {**env_vars(prog), **vmap}
        items = []
        for target in targets:
            items.extend(
                collect_directive_items(
                    "rule",
                    target,
                    cli_vars=merged_vmap,
                    refresh=refresh,
                )
            )
        out = format_collected_rules(items, verbose=verbose)
        if out:
            sys.stdout.write(out + "\n")
        return 0
    if args and args[0] in ("--list", "-l"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --list [package]")
        return cmd_list_rules(args[1] if len(args) == 2 else DEFAULT_RULES_PKG)
    if args and args[0] == "--update-cache":
        return cmd_update_cache()
    if args and args[0] == "--init":
        force = "--force" in args[1:]
        rest = [a for a in args[1:] if a != "--force"]
        if rest:
            raise SystemExit(f"{prog}: usage: {prog} --init [--force]")
        return cmd_init(force=force)
    if args and args[0] == "--tree":
        return cmd_tree(args[1:])
    if args and args[0] == "--check-update":
        return cmd_check_update()
    if args and args[0] in ("--update", "--self-update"):
        return cmd_update(force="--force" in args[1:])
    if args and args[0] == "--uninstall":
        if len(args) > 1:
            raise SystemExit(f"{prog}: usage: {prog} --uninstall")
        return cmd_uninstall()
    return cmd_bundle(args)


if __name__ == "__main__":
    raise SystemExit(main())
