def prog_name() -> str:
    raw = Path(sys.argv[0]).name if sys.argv and sys.argv[0] else "agents_bundle"
    for suf in (".py", ".cmd", ".bat", ".exe"):
        if raw.lower().endswith(suf) and len(raw) > len(suf):
            raw = raw[:-len(suf)]
            break
    return raw or "agents_bundle"


def cache_dir_path() -> Path:
    env_c = os.environ.get("AGENTS_BUNDLE_CACHE_DIR")
    if env_c:
        return Path(env_c).expanduser()
    xdg = os.environ.get("XDG_CACHE_HOME")
    base = Path(xdg).expanduser() if xdg else (Path.home() / ".cache")
    return base / "agents_bundle"


def usage_text() -> str:
    return (__doc__ or "").format(
        prog=prog_name(),
        default_pkg=DEFAULT_RULES_PKG,
        cache_dir=cache_dir_path(),
    )


def approx_tokens(text: str) -> int:
    return math.ceil(len(text) / 4)


_TREE_SKIP_DIRS = {
    ".git",
    "__pycache__",
    "node_modules",
    ".venv",
    "venv",
    "dist",
    "build",
    ".tox",
    ".mypy_cache",
    ".pytest_cache",
    ".ruff_cache",
    "target",
}


def _normalize_exclude_path(raw: str) -> str:
    s = Path(raw.strip()).as_posix().strip("/")
    while s.startswith("./"):
        s = s[2:].strip("/")
    return s


def _is_under_excluded(rel_posix: str, excluded_set: set[str]) -> str | None:
    for ex in excluded_set:
        if rel_posix == ex or rel_posix.startswith(ex + "/"):
            return ex
    return None


def _collect_repo_files(root: Path, excluded_set: set[str]) -> tuple[list[str], set[str]]:
    found_excluded: set[str] = set()
    for ex in excluded_set:
        if (root / ex).is_dir():
            found_excluded.add(ex)

    try:
        r = subprocess.run(
            ["git", "-C", str(root), "ls-files", "--cached", "--others", "--exclude-standard"],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=5,
            check=False,
        )
        if r.returncode == 0:
            files = []
            for raw in r.stdout.splitlines():
                rel = raw.strip()
                if not rel:
                    continue
                rel_posix = Path(rel).as_posix()
                matched_ex = _is_under_excluded(rel_posix, excluded_set)
                if matched_ex is not None:
                    found_excluded.add(matched_ex)
                    continue
                p = root / rel_posix
                if p.is_file() and not p.is_symlink():
                    files.append(rel_posix)
            return sorted(set(files)), found_excluded
    except Exception:
        pass

    files = []
    for dirpath, dirnames, filenames in os.walk(root):
        rel_dir_obj = Path(dirpath).relative_to(root)
        rel_dir_str = "" if str(rel_dir_obj) == "." else rel_dir_obj.as_posix()
        kept_dirs: list[str] = []
        for d in sorted(dirnames):
            if d in _TREE_SKIP_DIRS or d.startswith(".git"):
                continue
            cand_rel = f"{rel_dir_str}/{d}" if rel_dir_str else d
            if cand_rel in excluded_set:
                found_excluded.add(cand_rel)
                continue
            kept_dirs.append(d)
        dirnames[:] = kept_dirs
        for fn in sorted(filenames):
            p = Path(dirpath) / fn
            if p.is_file() and not p.is_symlink():
                rel_p = f"{rel_dir_str}/{fn}" if rel_dir_str else fn
                files.append(rel_p)
    return sorted(set(files)), found_excluded


def _inspect_file_meta(path: Path) -> tuple[int, bool, int]:
    try:
        size = path.stat().st_size
        with path.open("rb") as f:
            head = f.read(4096)
            if b"\x00" in head:
                return 0, True, size
            rest = f.read(512 * 1024)
        data = head + rest
        n_lines = data.count(b"\n") + (1 if data and not data.endswith(b"\n") else 0)
        return n_lines, False, size
    except OSError:
        return 0, False, 0


def build_repo_tree(
    root_dir: Path | None = None,
    max_lines: int = 160,
    max_tokens: int = 1600,
    exclude_dirs: list[str] | None = None,
) -> str:
    root = (root_dir if root_dir is not None else Path.cwd()).resolve()
    excluded_input = {
        _normalize_exclude_path(x)
        for x in (exclude_dirs or [])
        if _normalize_exclude_path(x)
    }
    rel_files, active_excluded = _collect_repo_files(root, excluded_input)
    file_info: dict[str, tuple[int, bool, int]] = {}
    dir_files: dict[str, list[str]] = {"": []}
    dir_subdirs: dict[str, list[str]] = {"": []}
    all_dirs: set[str] = {""}

    def ensure_dir_chain(dir_path: str) -> None:
        if not dir_path:
            return
        parts = dir_path.split("/")
        cur = ""
        for part in parts:
            nxt = f"{cur}/{part}" if cur else part
            if nxt not in all_dirs:
                all_dirs.add(nxt)
                dir_files[nxt] = []
                dir_subdirs[nxt] = []
                dir_subdirs[cur].append(nxt)
            cur = nxt

    for ex_dir in sorted(active_excluded):
        ensure_dir_chain(ex_dir)

    for rel in rel_files:
        info = _inspect_file_meta(root / rel)
        file_info[rel] = info
        parts = rel.split("/")
        parent_dir = "/".join(parts[:-1])
        ensure_dir_chain(parent_dir)
        dir_files[parent_dir].append(rel)

    for d in all_dirs:
        dir_subdirs[d].sort()
        dir_files[d].sort()

    dirs_bottom_up = sorted(all_dirs, key=lambda x: (0 if not x else x.count("/") + 1), reverse=True)
    dir_totals: dict[str, tuple[int, int]] = {}
    for d in dirs_bottom_up:
        if d in active_excluded:
            dir_totals[d] = (0, 0)
            continue
        f_cnt = len(dir_files[d])
        l_cnt = sum(file_info[f][0] for f in dir_files[d])
        for sub in dir_subdirs[d]:
            sf, sl = dir_totals[sub]
            f_cnt += sf
            l_cnt += sl
        dir_totals[d] = (f_cnt, l_cnt)

    def render_dir(
        d: str,
        prefix: str,
        collapsed: set[str],
        file_limits: dict[str, int],
    ) -> list[str]:
        out: list[str] = []
        subs = dir_subdirs[d]
        files = dir_files[d]
        limit = file_limits.get(d)
        extra_files = 0
        extra_lines = 0
        if limit is not None and len(files) > limit:
            hidden = files[limit:]
            extra_files = len(hidden)
            extra_lines = sum(file_info[f][0] for f in hidden)
            files = files[:limit]

        entries: list[tuple[str, str]] = [("dir", s) for s in subs] + [("file", f) for f in files]
        if extra_files > 0:
            entries.append(("more", f"... (+{extra_files} more file{'s' if extra_files != 1 else ''}, {extra_lines:,}L)"))

        for idx, (kind, item) in enumerate(entries):
            is_last = idx == len(entries) - 1
            conn = "└── " if is_last else "├── "
            child_prefix = prefix + ("    " if is_last else "│   ")
            if kind == "dir":
                name = item.rsplit("/", 1)[-1]
                if item in active_excluded:
                    out.append(f"{prefix}{conn}{name}/ (excluded)")
                elif item in collapsed:
                    fc, lc = dir_totals[item]
                    out.append(f"{prefix}{conn}{name}/ ({fc} file{'s' if fc != 1 else ''}, {lc:,}L)")
                else:
                    out.append(f"{prefix}{conn}{name}/")
                    out.extend(render_dir(item, child_prefix, collapsed, file_limits))
            elif kind == "file":
                name = item.rsplit("/", 1)[-1]
                lines_n, is_bin, sz = file_info[item]
                tag = f"({sz:,}B)" if is_bin else f"({lines_n}L)"
                out.append(f"{prefix}{conn}{name} {tag}")
            else:
                out.append(f"{prefix}{conn}{item}")
        return out

    collapsed: set[str] = set()
    file_limits: dict[str, int] = {}
    total_f, total_l = dir_totals[""]
    footer = f"# Total: {total_f} file{'s' if total_f != 1 else ''}, {total_l:,} lines"

    def is_visible_dir(d: str) -> bool:
        if d == "" or d in active_excluded or d in collapsed:
            return False
        cur = d
        while "/" in cur:
            cur = cur.rsplit("/", 1)[0]
            if cur in collapsed or cur in active_excluded:
                return False
        return True

    while True:
        body = [f"{root.name}/"] + render_dir("", "", collapsed, file_limits)
        full_lines = body + [footer]
        tok = approx_tokens("\n".join(full_lines))
        if len(full_lines) <= max_lines and tok <= max_tokens:
            return "\n".join(full_lines) + "\n"

        # Stage 1: collapse nested subdirectories (depth >= 1) first, deepest first.
        # Include single-file deep chains when they have subdirectories or files inside.
        deep_candidates = [
            d for d in all_dirs
            if "/" in d and is_visible_dir(d) and (len(dir_subdirs[d]) + len(dir_files[d]) > 0)
        ]
        if deep_candidates:
            best_deep = max(deep_candidates, key=lambda d: (d.count("/"), dir_totals[d][0]))
            collapsed.add(best_deep)
            # Clean up any child collapses under best_deep so set stays small
            prefix_slash = best_deep + "/"
            collapsed = {c for c in collapsed if not c.startswith(prefix_slash)}
            continue

        # Stage 2: truncate file lists in visible directories (down to 8, then 5) before collapsing top-level dirs
        trunc_candidates = []
        for d in all_dirs:
            if d != "" and not is_visible_dir(d):
                continue
            cur_lim = file_limits.get(d, len(dir_files[d]))
            if len(dir_files[d]) > 6 and cur_lim > 5:
                trunc_candidates.append((cur_lim, len(dir_files[d]), d))
        if trunc_candidates:
            _, _, best_trunc = max(trunc_candidates)
            cur_lim = file_limits.get(best_trunc, len(dir_files[best_trunc]))
            file_limits[best_trunc] = 8 if cur_lim > 10 else 5
            continue

        # Stage 3: collapse top-level directories if still over budget
        top_candidates = [
            d for d in dir_subdirs[""]
            if is_visible_dir(d) and (len(dir_subdirs[d]) + len(dir_files[d]) > 0)
        ]
        if top_candidates:
            best_top = max(top_candidates, key=lambda d: dir_totals[d][0])
            collapsed.add(best_top)
            continue

        return "\n".join(full_lines[: max(2, max_lines - 1)] + [footer]) + "\n"


def _tree_from_args(argv: list[str], default_dir: Path | None = None) -> str:
    prog = prog_name()
    max_lines = 160
    max_tokens = 1600
    exclude_dirs: list[str] = []
    target_dir: Path | None = default_dir
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--max-lines":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --max-lines requires an integer")
            try:
                max_lines = max(5, int(argv[i + 1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-lines value: {argv[i + 1]!r}")
            i += 2
        elif a.startswith("--max-lines="):
            try:
                max_lines = max(5, int(a.split("=", 1)[1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-lines value: {a!r}")
            i += 1
        elif a == "--max-tokens":
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: --max-tokens requires an integer")
            try:
                max_tokens = max(20, int(argv[i + 1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-tokens value: {argv[i + 1]!r}")
            i += 2
        elif a.startswith("--max-tokens="):
            try:
                max_tokens = max(20, int(a.split("=", 1)[1]))
            except ValueError:
                raise SystemExit(f"{prog}: invalid --max-tokens value: {a!r}")
            i += 1
        elif a in ("-x", "--exclude"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires a directory name")
            for part in argv[i + 1].split(","):
                if part.strip():
                    exclude_dirs.append(part.strip())
            i += 2
        elif a.startswith("--exclude="):
            for part in a.split("=", 1)[1].split(","):
                if part.strip():
                    exclude_dirs.append(part.strip())
            i += 1
        elif a.startswith("-"):
            raise SystemExit(
                f"{prog}: usage: {prog} --tree [DIR] [-x/--exclude DIR] [--max-lines N] [--max-tokens N]"
            )
        else:
            p = Path(a).expanduser()
            if default_dir is not None and not p.is_absolute():
                p = default_dir / p
            if not p.is_dir():
                raise SystemExit(f"{prog}: directory not found: {a}")
            target_dir = p
            i += 1
    return build_repo_tree(
        root_dir=target_dir,
        max_lines=max_lines,
        max_tokens=max_tokens,
        exclude_dirs=exclude_dirs,
    )


def cmd_tree(argv: list[str]) -> int:
    sys.stdout.write(_tree_from_args(argv))
    return 0


RULE_VAR_RE = re.compile(r"\{([A-Za-z_][A-Za-z0-9_]*):([^{}]*)\}")
IF_PREFIX_RE = re.compile(r"^\[if\s+([^\]]+)\]\s*(.*)$")


def _render_rule_vars(text: str, vars_map: dict[str, str]) -> str:
    return RULE_VAR_RE.sub(lambda m: vars_map.get(m.group(1), m.group(2)), text)


def _detect_os_name() -> str:
    if os.name == "nt":
        return "windows"
    if sys.platform == "darwin":
        return "macos"
    return "linux"


def _detect_vcs_name(work_dir: Path | None = None) -> str:
    wdir = (work_dir if work_dir is not None else Path.cwd()).resolve()
    cur = wdir
    while True:
        if (cur / ".git").exists():
            return "git"
        if (cur / "CVS").is_dir():
            return "cvs"
        if cur.parent == cur:
            break
        cur = cur.parent
    return ""


def builtin_vars(work_dir: Path | None = None) -> dict[str, str]:
    return {
        "os": _detect_os_name(),
        "vcs": _detect_vcs_name(work_dir),
    }


def eval_if_condition(cond_expr: str, vars_map: dict[str, str], prog: str | None = None) -> bool:
    p = prog or prog_name()
    tokens = shlex.split(cond_expr.strip())
    if not tokens:
        raise SystemExit(f"{p}: empty [if ...] condition")
    for tok in tokens:
        if "!=" in tok:
            k, expected = tok.split("!=", 1)
            k = k.strip()
            allowed = {v.strip() for v in expected.split(",")}
            actual = vars_map.get(k, "")
            if actual in allowed:
                return False
        elif "=" in tok:
            k, expected = tok.split("=", 1)
            k = k.strip()
            allowed = {v.strip() for v in expected.split(",")}
            actual = vars_map.get(k, "")
            if actual not in allowed:
                return False
        else:
            raise SystemExit(f"{p}: invalid condition token {tok!r} in '[if {cond_expr}]' (expected key=val or key!=val)")
    return True


def strip_if_blocks_and_lines(raw_text: str, prog: str | None = None) -> list[tuple[str | None, str]]:
    """Parses raw lines supporting '[if cond] <line>' and '[if cond] ... [/if]' blocks.
    Returns list of (cond_expr_or_None, inner_line).
    """
    p = prog or prog_name()
    out: list[tuple[str | None, str]] = []
    block_stack: list[str] = []
    for raw_line in raw_text.splitlines():
        line = raw_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.lower() in ("[/if]", "[endif]"):
            if not block_stack:
                raise SystemExit(f"{p}: unexpected {line!r} without matching '[if ...]'")
            block_stack.pop()
            continue
        m = IF_PREFIX_RE.match(line)
        if m:
            cond_s = m.group(1).strip()
            rest = m.group(2).strip()
            if not rest:
                block_stack.append(cond_s)
                continue
            combined = " ".join([*block_stack, cond_s])
            out.append((combined, rest))
            continue
        combined = " ".join(block_stack) if block_stack else None
        out.append((combined, line))
    if block_stack:
        raise SystemExit(f"{p}: unclosed '[if {block_stack[-1]}]' block (missing '[/if]')")
    return out


def _parse_md_text(raw_text: str, fallback_desc: str) -> tuple[str, str]:
    lines = raw_text.splitlines()
    desc = fallback_desc
    body_lines = lines
    if lines and lines[0].startswith("# Description:"):
        desc = lines[0].split(":", 1)[1].strip()
        body_lines = lines[1:]
    return desc, "\n".join(body_lines).strip()


def _parse_directive_tokens(tokens: list[str], prog: str) -> tuple[str, list[str], dict[str, str]]:
    if not tokens:
        raise SystemExit(f"{prog}: missing target in preset/rule directive")
    target = tokens[0].strip()
    excludes: list[str] = []
    vars_map: dict[str, str] = {}
    for tok in tokens[1:]:
        s = tok.strip()
        if not s:
            continue
        if "=" in s and not s.startswith("-"):
            k, v = s.split("=", 1)
            k_clean = k.strip()
            if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", k_clean):
                raise SystemExit(f"{prog}: invalid variable name {k_clean!r} in {s!r}")
            vars_map[k_clean] = v.strip()
        elif s.startswith("-") and len(s) > 1:
            excludes.append(s[1:].strip())
        else:
            raise SystemExit(f"{prog}: unexpected argument {s!r} after target {target!r}")
    return target, excludes, vars_map


def _parse_preset_file(
    raw_text: str,
    fallback_desc: str,
) -> tuple[str, list[tuple[str | None, str, str, list[str], dict[str, str]]]]:
    prog = prog_name()
    desc = fallback_desc
    for raw_line in raw_text.splitlines():
        s = raw_line.strip()
        if s.startswith("# Description:"):
            desc = s.split(":", 1)[1].strip()
            break
    directives: list[tuple[str | None, str, str, list[str], dict[str, str]]] = []
    for cond_expr, line in strip_if_blocks_and_lines(raw_text, prog):
        parts = shlex.split(line)
        if not parts or parts[0] not in ("preset", "rule"):
            raise SystemExit(
                f"{prog}: invalid line in preset {fallback_desc!r}: {line!r} (expected 'preset ...' or 'rule ...')"
            )
        kind = parts[0]
        target, excls, vmap = _parse_directive_tokens(parts[1:], prog)
        directives.append((cond_expr, kind, target, excls, vmap))
    return desc, directives


def _load_package_from_dir(
    pkg_dir: Path,
) -> tuple[
    dict[str, tuple[str, str]],
    dict[str, tuple[str, list[tuple[str | None, str, str, list[str], dict[str, str]]]]],
]:
    rules: dict[str, tuple[str, str]] = {}
    presets: dict[str, tuple[str, list[tuple[str | None, str, str, list[str], dict[str, str]]]]] = {}
    r_root = pkg_dir / "rules" if (pkg_dir / "rules").is_dir() else (pkg_dir / "src/rules")
    p_root = pkg_dir / "presets" if (pkg_dir / "presets").is_dir() else (pkg_dir / "src/presets")
    if r_root.is_dir():
        for p in sorted(r_root.rglob("*.md")):
            if p.is_file():
                rel = p.relative_to(r_root).with_suffix("").as_posix().lower()
                rules[rel] = _parse_md_text(p.read_text(encoding="utf-8", errors="replace"), rel)
    if p_root.is_dir():
        for p in sorted(p_root.rglob("*.preset")):
            if p.is_file():
                rel = p.relative_to(p_root).with_suffix("").as_posix().lower()
                presets[rel] = _parse_preset_file(p.read_text(encoding="utf-8", errors="replace"), rel)
    return rules, presets


def _ensure_remote_package(pkg_spec: str, refresh: bool = False) -> Path:
    prog = prog_name()
    local_override = os.environ.get("AGENTS_BUNDLE_LOCAL_PKG_DIR")
    if local_override and pkg_spec == DEFAULT_RULES_PKG and Path(local_override).is_dir():
        return Path(local_override)
    home_candidate = Path.home() / "agents_rules"
    if pkg_spec == DEFAULT_RULES_PKG and not refresh and (home_candidate / "rules").is_dir() and (home_candidate / "presets").is_dir():
        cdir_chk = cache_dir_path() / "packages" / pkg_spec
        if not cdir_chk.is_dir():
            return home_candidate

    ref = ""
    repo_part = pkg_spec
    if "@" in pkg_spec:
        repo_part, ref = pkg_spec.rsplit("@", 1)
    if repo_part.startswith(("http://", "https://", "git@")):
        url = repo_part
        slug = re.sub(r"[^A-Za-z0-9._-]+", "_", repo_part.strip("/"))
    elif re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo_part):
        url = f"https://github.com/{repo_part}.git"
        slug = repo_part
    else:
        raise SystemExit(f"{prog}: invalid package reference {pkg_spec!r}")

    cdir = cache_dir_path() / "packages" / (f"{slug}@{ref}" if ref else slug)
    if cdir.is_dir() and not refresh:
        return cdir
    cdir.parent.mkdir(parents=True, exist_ok=True)
    if cdir.is_dir() and refresh:
        shutil.rmtree(cdir, ignore_errors=True)
    cmd = ["git", "clone", "--depth", "1"]
    if ref:
        cmd.extend(["--branch", ref])
    cmd.extend([url, str(cdir)])
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, check=False)
    if r.returncode != 0:
        raise SystemExit(f"{prog}: failed to fetch package {pkg_spec!r}: {r.stderr.strip()}")
    return cdir


def _get_package_catalog(
    pkg_id: str,
    refresh: bool = False,
) -> tuple[
    dict[str, tuple[str, str]],
    dict[str, tuple[str, list[tuple[str | None, str, str, list[str], dict[str, str]]]]],
]:
    local_dir = Path(pkg_id).expanduser()
    if local_dir.is_dir():
        return _load_package_from_dir(local_dir)
    pkg_dir = _ensure_remote_package(pkg_id, refresh=refresh)
    return _load_package_from_dir(pkg_dir)


def _fetch_url_file(url: str, refresh: bool = False) -> Path:
    prog = prog_name()
    slug = re.sub(r"[^A-Za-z0-9._-]+", "_", url)
    cpath = cache_dir_path() / "urls" / slug
    if cpath.is_file() and not refresh:
        return cpath
    cpath.parent.mkdir(parents=True, exist_ok=True)
    try:
        req = urllib.request.Request(url, headers={"User-Agent": f"agents_bundle/{VERSION}"})
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = resp.read().decode("utf-8")
        cpath.write_text(data, encoding="utf-8")
        return cpath
    except Exception as exc:
        raise SystemExit(f"{prog}: failed to fetch {url!r}: {exc}")


def _parse_target_spec(spec: str, default_pkg: str | None = None) -> tuple[str, str]:
    prog = prog_name()
    if ":" not in spec and spec.startswith(("./", "../", "~/", "/")):
        return "__file__", spec
    if spec.startswith(("http://", "https://", "file://")):
        idx = spec.rfind(":")
        scheme_end = spec.find("://") + 2
        if idx <= scheme_end or spec.endswith((".md", ".preset")):
            return "__url__", spec
        return spec[:idx], spec[idx + 1:].strip().lower()
    if ":" not in spec:
        if default_pkg:
            return default_pkg, spec.strip().lower()
        raise SystemExit(
            f"{prog}: missing package prefix in {spec!r} (expected '<owner>/<repo>:{spec}' or './path')"
        )
    pkg, item = spec.split(":", 1)
    if not pkg.strip() or not item.strip():
        raise SystemExit(f"{prog}: invalid target {spec!r}; expected <package>:<item>")
    return pkg.strip(), item.strip().lower()


def _match_rule_in_dict(name: str, rules_dict: dict[str, tuple[str, str]]) -> str | None:
    if name in rules_dict:
        return name
    matches = [k for k in rules_dict if k.rsplit("/", 1)[-1] == name]
    if len(matches) == 1:
        return matches[0]
    return None


def collect_directive_items(
    kind: str,
    target_spec: str,
    excludes: list[str] | None = None,
    cli_vars: dict[str, str] | None = None,
    work_dir: Path | None = None,
    refresh: bool = False,
    default_pkg: str | None = None,
    trace_prefix: list[str] | None = None,
) -> list[tuple[str, str, str]]:
    """Returns list of (rule_uid, provenance_comment, rendered_body)."""
    prog = prog_name()
    if kind not in ("preset", "rule"):
        raise SystemExit(f"{prog}: directive kind must be 'preset' or 'rule' (got {kind!r})")

    pkg_id, item_name = _parse_target_spec(target_spec, default_pkg=default_pkg)
    excl_set: set[str] = set()
    for ex in excludes or []:
        clean_ex = ex.lstrip("-").strip().lower()
        if ":" in clean_ex:
            _, clean_ex = clean_ex.split(":", 1)
        if clean_ex:
            excl_set.add(clean_ex)

    effective_vars = {**builtin_vars(work_dir), **(cli_vars or {})}
    cur_trace = list(trace_prefix or [f"{kind} {target_spec}"])

    if pkg_id in ("__file__", "__url__"):
        if pkg_id == "__url__":
            fpath = _fetch_url_file(item_name, refresh=refresh)
            base_url = item_name.rsplit("/", 1)[0] if "/" in item_name else DEFAULT_RULES_PKG
        else:
            fpath = Path(item_name).expanduser()
            if work_dir is not None and not fpath.is_absolute():
                fpath = (work_dir / fpath).resolve()
            if not fpath.is_file():
                raise SystemExit(f"{prog}: {kind} file not found: {item_name}")
            base_url = DEFAULT_RULES_PKG
        raw = fpath.read_text(encoding="utf-8", errors="replace")
        if kind == "preset":
            _, directives = _parse_preset_file(raw, fpath.stem)
            items_out: list[tuple[str, str, str]] = []
            for cond_expr, sub_kind, sub_target, sub_excls, sub_vars in directives:
                merged_vars = {**effective_vars, **sub_vars, **(cli_vars or {})}
                if cond_expr and not eval_if_condition(cond_expr, merged_vars, prog):
                    continue
                merged_excls = list(excludes or []) + sub_excls
                step_label = f"[if {cond_expr}] {sub_kind} {sub_target}" if cond_expr else f"{sub_kind} {sub_target}"
                items_out.extend(
                    collect_directive_items(
                        sub_kind,
                        (f"{base_url}/{sub_target}" if (pkg_id == "__url__" and ":" not in sub_target and sub_target.endswith((".md", ".preset"))) else sub_target),
                        excludes=merged_excls,
                        cli_vars=merged_vars,
                        work_dir=work_dir,
                        refresh=refresh,
                        default_pkg=DEFAULT_RULES_PKG,
                        trace_prefix=[*cur_trace, step_label],
                    )
                )
            return items_out
        _, body = _parse_md_text(raw, fpath.stem)
        rendered = _render_rule_vars(body, effective_vars).strip()
        if not rendered:
            return []
        used_keys = {m.group(1) for m in RULE_VAR_RE.finditer(body)}
        active_vars = {k: v for k, v in effective_vars.items() if k in used_keys}
        vars_s = f" ({', '.join(f'{k}={v}' for k, v in active_vars.items())})" if active_vars else ""
        prov = f"# [{' -> '.join(cur_trace)}]{vars_s}"
        return [(str(fpath), prov, rendered)]

    def is_excluded(rk: str) -> bool:
        leaf = rk.rsplit("/", 1)[-1]
        return rk in excl_set or leaf in excl_set

    if kind == "rule":
        rules_dict, _ = _get_package_catalog(pkg_id, refresh=refresh)
        rk = _match_rule_in_dict(item_name, rules_dict)
        if rk is None:
            avail_r = sorted(rules_dict.keys())
            raise SystemExit(
                f"{prog}: unknown rule {item_name!r} in package {pkg_id!r} (available rules: {', '.join(avail_r)})"
            )
        if is_excluded(rk):
            return []
        raw_body = rules_dict[rk][1].strip()
        rendered = _render_rule_vars(raw_body, effective_vars)
        if not rendered:
            return []
        used_keys = {m.group(1) for m in RULE_VAR_RE.finditer(raw_body)}
        active_vars = {k: v for k, v in effective_vars.items() if k in used_keys}
        chain = [*cur_trace, f"rules/{rk}.md"] if (len(cur_trace) > 1 and cur_trace[-1].startswith("[if ")) else [*(cur_trace[:-1] if len(cur_trace) > 1 else cur_trace), f"rules/{rk}.md"]
        vars_s = f" ({', '.join(f'{k}={v}' for k, v in active_vars.items())})" if active_vars else ""
        prov = f"# [{' -> '.join(chain)}]{vars_s}"
        return [(f"{pkg_id}:{rk}", prov, rendered)]

    # kind == "preset"
    _, presets_dict = _get_package_catalog(pkg_id, refresh=refresh)
    if item_name not in presets_dict:
        avail_p = sorted(presets_dict.keys())
        raise SystemExit(
            f"{prog}: unknown preset {item_name!r} in package {pkg_id!r} (available presets: {', '.join(avail_p)})"
        )
    _, directives = presets_dict[item_name]
    out_items: list[tuple[str, str, str]] = []
    for cond_expr, sub_kind, sub_target, sub_excls, sub_vars in directives:
        merged_vars = {**effective_vars, **sub_vars, **(cli_vars or {})}
        if cond_expr and not eval_if_condition(cond_expr, merged_vars, prog):
            continue
        merged_excls = list(excludes or []) + sub_excls
        step_label = f"[if {cond_expr}] {sub_kind} {sub_target}" if cond_expr else f"{sub_kind} {sub_target}"
        out_items.extend(
            collect_directive_items(
                sub_kind,
                sub_target,
                excludes=merged_excls,
                cli_vars=merged_vars,
                work_dir=work_dir,
                refresh=refresh,
                default_pkg=pkg_id,
                trace_prefix=[*cur_trace, step_label],
            )
        )
    return out_items


def format_collected_rules(items: list[tuple[str, str, str]], verbose: bool = False) -> str:
    seen: set[str] = set()
    chunks: list[str] = []
    for uid, prov, body in items:
        if uid in seen:
            continue
        seen.add(uid)
        if verbose:
            chunks.append(f"{prov}\n{body}")
        else:
            chunks.append(body)
    sep = "\n\n" if verbose else "\n"
    return sep.join(chunks)


def render_directive(
    kind: str,
    target_spec: str,
    excludes: list[str] | None = None,
    cli_vars: dict[str, str] | None = None,
    work_dir: Path | None = None,
    refresh: bool = False,
    default_pkg: str | None = None,
    verbose: bool = False,
) -> str:
    items = collect_directive_items(
        kind,
        target_spec,
        excludes=excludes,
        cli_vars=cli_vars,
        work_dir=work_dir,
        refresh=refresh,
        default_pkg=default_pkg,
    )
    return format_collected_rules(items, verbose=verbose)


def cmd_list_rules(pkg_id: str = DEFAULT_RULES_PKG) -> int:
    rules_dict, presets_dict = _get_package_catalog(pkg_id)
    bvars = builtin_vars()
    sys.stdout.write("Built-in variables (usable in '[if key=val]' conditions and rule templates):\n")
    sys.stdout.write(f"  {'os':<38}  Active operating system (linux, macos, windows; current: {bvars['os']!r})\n")
    sys.stdout.write(f"  {'vcs':<38}  Detected repository VCS (git, cvs, or ''; current: {bvars['vcs']!r})\n\n")
    sys.stdout.write(f"Presets in '{pkg_id}' (use as 'preset {pkg_id}:<preset>'):\n")
    for k, (desc, directives) in presets_dict.items():
        target_tag = f"{pkg_id}:{k}"
        sys.stdout.write(f"  {target_tag:<38}  {desc}\n")
        for cond_expr, d_kind, d_tgt, d_ex, d_vars in directives:
            cond_s = f"[if {cond_expr}] " if cond_expr else ""
            ex_s = (" " + " ".join(f"-{e}" for e in d_ex)) if d_ex else ""
            var_s = (" " + " ".join(f"{vk}={vv}" for vk, vv in d_vars.items())) if d_vars else ""
            sys.stdout.write(f"  {'':<38}    {cond_s}{d_kind} {d_tgt}{ex_s}{var_s}\n")
    sys.stdout.write(f"\nAtomic rules in '{pkg_id}' (use as 'rule {pkg_id}:<rule>'):\n")
    for k, (desc, _) in rules_dict.items():
        target_tag = f"{pkg_id}:{k}"
        sys.stdout.write(f"  {target_tag:<38}  {desc}\n")
    return 0


def cmd_update_cache() -> int:
    pdir = cache_dir_path() / "packages"
    if not pdir.is_dir():
        sys.stdout.write(f"No cached packages in {pdir}\n")
        return 0
    updated = 0
    for git_dir in sorted(pdir.rglob(".git")):
        repo_root = git_dir.parent
        r = subprocess.run(["git", "-C", str(repo_root), "pull", "--ff-only"], capture_output=True, text=True, check=False)
        if r.returncode == 0:
            updated += 1
            sys.stdout.write(f"Updated {repo_root.relative_to(pdir)}\n")
        else:
            sys.stderr.write(f"Failed to update {repo_root}: {r.stderr.strip()}\n")
    sys.stdout.write(f"Refreshed {updated} cached package(s).\n")
    return 0


def default_spec_template(prog: str | None = None) -> str:
    cmd = prog or prog_name()
    lines = [
        f"# {SPEC_FILE_NAME} — root context preset and command bundle for '{cmd}'",
        "# Directives:",
        f"#   preset <owner>/<repo>:<name> [-exclude ...] [key=val ...]",
        f"#   rule <owner>/<repo>:<name> [key=val ...]",
        "#   [if os=linux] rule <owner>/<repo>:os/linux  (or multi-line [if ...] ... [/if])",
        "#   $ <shell command>  (use '$ cat <file>' to include a file)",
        "",
        f"preset {DEFAULT_RULES_PKG}:default",
        "",
        "$ cat AGENTS.md",
        f"$ {cmd} --tree",
        "$ git status -sb",
        "$ git branch -vv",
        "$ git log --oneline -10",
        "",
    ]
    return "\n".join(lines)


def cmd_init(force: bool = False, target_dir: Path | None = None) -> int:
    prog = prog_name()
    base_dir = (target_dir if target_dir is not None else Path.cwd()).resolve()
    path = base_dir / SPEC_FILE_NAME
    if path.exists() and not force:
        sys.stderr.write(f"{prog}: {path} already exists (use --force to overwrite)\n")
        return 2
    path.write_text(default_spec_template(prog), encoding="utf-8")
    sys.stdout.write(f"{prog}: wrote starter {SPEC_FILE_NAME} to {path}\n")
    return 0


def find_spec_file(start_dir: Path | None = None) -> Path | None:
    cur = (start_dir if start_dir is not None else Path.cwd()).resolve()
    candidate = cur / SPEC_FILE_NAME
    if candidate.is_file():
        return candidate
    return None


def parse_spec(
    text: str,
    work_dir: Path | None = None,
    cli_vars: dict[str, str] | None = None,
) -> list[tuple[str, str, str | None]]:
    prog = prog_name()
    bvars = {**builtin_vars(work_dir), **(cli_vars or {})}
    entries: list[tuple[str, str, str | None]] = []
    for cond_expr, raw_line in strip_if_blocks_and_lines(text, prog):
        if cond_expr and not eval_if_condition(cond_expr, bvars, prog):
            continue
        line = _render_rule_vars(raw_line, bvars).strip()
        if line.startswith("$ ") or line.startswith("! "):
            cmd_str = line[2:].strip()
            if cmd_str:
                entries.append(("cmd", cmd_str, cond_expr))
        elif line in ("$", "!"):
            continue
        elif line.startswith("preset ") or line.startswith("rule "):
            entries.append(("directive", line, cond_expr))
        else:
            raise SystemExit(
                f"{prog}: invalid line in {SPEC_FILE_NAME}: {line!r} (expected 'preset ...', 'rule ...', '[if ...]', or '$ <command>')"
            )
    return entries


def _run_spec_command(cmd_str: str, cwd: Path) -> tuple[int, str]:
    prog = prog_name()
    self_dir = str(Path(__file__).resolve().parent)
    if re.match(rf"^(?:{re.escape(prog)}|agents_bundle)\s+--tree(?:\s+.*)?$", cmd_str):
        try:
            parts = shlex.split(cmd_str)[2:]
            return 0, _tree_from_args(parts, default_dir=cwd).rstrip()
        except SystemExit as exc:
            return 1, str(exc)

    shell_bin = os.environ.get("AGENTS_BUNDLE_SHELL", "bash").strip() or "bash"
    env = {**os.environ, "PYTHONUTF8": "1"}
    env["PATH"] = f"{self_dir}{os.pathsep}{Path.home() / '.local/bin'}{os.pathsep}{env.get('PATH', '')}"
    try:
        r = subprocess.run(
            [shell_bin, "-c", cmd_str],
            cwd=str(cwd),
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            env=env,
            check=False,
        )
        return r.returncode, r.stdout.decode("utf-8", errors="replace").rstrip()
    except OSError as exc:
        return 1, f"[error running {cmd_str!r}: {exc}]"


def build_bundle(
    work_dir: Path | None = None,
    extra_files: list[str] | None = None,
    prompt_text: str | None = None,
    refresh: bool = False,
    verbose: bool = False,
    cli_vars: dict[str, str] | None = None,
) -> tuple[str, list[str]]:
    prog = prog_name()
    wdir = (work_dir if work_dir is not None else Path.cwd()).resolve()
    spec_file = find_spec_file(wdir)
    if spec_file is None:
        sys.stderr.write(f"{prog}: {SPEC_FILE_NAME} not found in {wdir} (run '{prog} --init' to create a starter template)\n")
        raise SystemExit(2)

    spec_dir = spec_file.parent
    entries = parse_spec(spec_file.read_text(encoding="utf-8"), work_dir=spec_dir, cli_vars=cli_vars)
    sections: list[tuple[str, str]] = []
    warnings: list[str] = []
    pending_rules: list[tuple[str, str, str]] = []

    def flush_pending_rules() -> None:
        if not pending_rules:
            return
        formatted = format_collected_rules(pending_rules, verbose=verbose).strip()
        pending_rules.clear()
        if formatted:
            sections.append(("Rules", formatted))

    for kind, val, cond_expr in entries:
        if kind == "directive":
            parts = shlex.split(val)
            d_kind = parts[0]
            target, excls, vmap = _parse_directive_tokens(parts[1:], prog)
            trace_start = f"[if {cond_expr}] {d_kind} {target}" if cond_expr else f"{d_kind} {target}"
            merged_vmap = {**vmap, **(cli_vars or {})}
            pending_rules.extend(
                collect_directive_items(
                    d_kind,
                    target,
                    excludes=excls,
                    cli_vars=merged_vmap,
                    work_dir=spec_dir,
                    refresh=refresh,
                    trace_prefix=[trace_start],
                )
            )
        elif kind == "cmd":
            flush_pending_rules()
            rc, out = _run_spec_command(val, spec_dir)
            if rc != 0:
                warnings.append(f"command exited {rc}: {val}")
            sections.append((f"$ {val}", out))
    flush_pending_rules()

    for extra in extra_files or []:
        clean = extra.strip()
        if not clean:
            continue
        p = (wdir / clean).resolve() if not Path(clean).is_absolute() else Path(clean).resolve()
        if not p.is_file():
            warnings.append(f"missing file: {clean}")
            continue
        try:
            disp = str(p.relative_to(spec_dir))
        except ValueError:
            disp = str(p)
        content = p.read_text(encoding="utf-8", errors="replace").rstrip()
        sections.append((f"$ cat {disp}", content))

    if prompt_text and prompt_text.strip():
        sections.append(("Prompt", prompt_text.strip()))

    blocks = [f"===== {title} =====\n{content}\n" for title, content in sections]
    return "\n".join(blocks), warnings


def cmd_bundle(argv: list[str]) -> int:
    prog = prog_name()
    work_dir: Path | None = None
    prompt_parts: list[str] = []
    extra_files: list[str] = []
    cli_vars: dict[str, str] = {}
    refresh = False
    verbose = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--refresh":
            refresh = True
            i += 1
        elif a in ("-v", "--verbose"):
            verbose = True
            i += 1
        elif a in ("-p", "--prompt"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires an argument")
            prompt_parts.append(argv[i + 1])
            i += 2
        elif a in ("-C", "--dir"):
            if i + 1 >= len(argv):
                raise SystemExit(f"{prog}: {a} requires a directory path")
            work_dir = Path(argv[i + 1]).expanduser()
            i += 2
        elif a.startswith("-"):
            raise SystemExit(f"{prog}: unknown option: {a}")
        elif "=" in a and re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*=.*", a, flags=re.DOTALL) and not Path(a).exists():
            k, v = a.split("=", 1)
            cli_vars[k.strip()] = v.strip()
            i += 1
        else:
            extra_files.append(a)
            i += 1

    prompt_text = "\n\n".join(prompt_parts) if prompt_parts else None
    body, warnings = build_bundle(
        work_dir=work_dir,
        extra_files=extra_files,
        prompt_text=prompt_text,
        refresh=refresh,
        verbose=verbose,
        cli_vars=cli_vars,
    )
    for w in warnings:
        sys.stderr.write(f"{prog}: warning: {w}\n")
    sys.stdout.write(body)
    return 0


def parse_version_from_source(source: str) -> str | None:
    m = re.search(r'^VERSION\s*=\s*["\x27]([^"\x27]+)["\x27]', source, flags=re.MULTILINE)
    return m.group(1) if m else None


def version_tuple(v: str) -> tuple[int, ...]:
    return tuple(int(p) for p in re.split(r"[^0-9]+", v) if p)


def fetch_remote_script(url: str | None = None) -> str:
    target_url = url or os.environ.get("AGENTS_BUNDLE_UPDATE_URL") or DEFAULT_UPDATE_URL
    if target_url.startswith(("http://", "https://")) and "?" not in target_url:
        target_url = f"{target_url}?t={int(time.time())}"
    req = urllib.request.Request(
        target_url,
        headers={"User-Agent": f"agents_bundle/{VERSION}", "Cache-Control": "no-cache"},
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        data = resp.read().decode("utf-8")
    if REPO_MARKER not in data:
        raise ValueError("downloaded file does not contain expected repository marker")
    ast.parse(data)
    return data


def cmd_check_update(url: str | None = None) -> int:
    prog = prog_name()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: failed to check for updates: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if version_tuple(remote_ver) > version_tuple(VERSION):
        sys.stdout.write(f"{prog}: update available: {VERSION} -> {remote_ver} (run '{prog} --update')\n")
    else:
        sys.stdout.write(f"{prog} {VERSION} is up to date (remote: {remote_ver}).\n")
    return 0


def cmd_update(force: bool = False, url: str | None = None) -> int:
    prog = prog_name()
    dest = Path(__file__).resolve()
    try:
        remote_src = fetch_remote_script(url)
    except Exception as exc:
        sys.stderr.write(f"{prog}: update failed: {exc}\n")
        return 1
    remote_ver = parse_version_from_source(remote_src) or "unknown"
    if not force and version_tuple(remote_ver) <= version_tuple(VERSION):
        sys.stdout.write(f"{prog} {VERSION} is already up to date.\n")
        return 0
    try:
        tmp_fd, tmp_name = tempfile.mkstemp(prefix=f".{dest.name}.", dir=str(dest.parent))
        try:
            with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
                f.write(remote_src)
            os.chmod(tmp_name, 0o755)
            os.replace(tmp_name, dest)
        except Exception:
            if os.path.exists(tmp_name):
                os.unlink(tmp_name)
            raise
    except Exception as exc:
        sys.stderr.write(f"{prog}: could not write updated binary to {dest}: {exc}\n")
        return 1
    sys.stdout.write(f"{prog}: updated {VERSION} -> {remote_ver} ({dest})\n")
    return 0


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    prog = prog_name()
    if "-h" in args or "--help" in args:
        sys.stdout.write(usage_text())
        return 0
    if "-V" in args or "--version" in args:
        sys.stdout.write(f"{prog} {VERSION}\n")
        return 0
    if args and args[0] in ("preset", "rule"):
        kind = args[0]
        refresh = "--refresh" in args[1:]
        verbose = "-v" in args[1:] or "--verbose" in args[1:]
        rest_tokens = [a for a in args[1:] if a not in ("--refresh", "-v", "--verbose")]
        target, excls, vmap = _parse_directive_tokens(rest_tokens, prog)
        out = render_directive(kind, target, excludes=excls, cli_vars=vmap, refresh=refresh, verbose=verbose)
        if out:
            sys.stdout.write(out + "\n")
        return 0
    if args and args[0] in ("--list", "-l"):
        if len(args) > 2:
            raise SystemExit(f"{prog}: usage: {prog} --list [package]")
        return cmd_list_rules(args[1] if len(args) == 2 else DEFAULT_RULES_PKG)
    if args and args[0] == "--update-cache":
        return cmd_update_cache()
    if args and args[0] == "--init":
        force = "--force" in args[1:]
        rest = [a for a in args[1:] if a != "--force"]
        if rest:
            raise SystemExit(f"{prog}: usage: {prog} --init [--force]")
        return cmd_init(force=force)
    if args and args[0] == "--tree":
        return cmd_tree(args[1:])
    if args and args[0] == "--check-update":
        return cmd_check_update()
    if args and args[0] in ("--update", "--self-update"):
        return cmd_update(force="--force" in args[1:])
    return cmd_bundle(args)


if __name__ == "__main__":
    raise SystemExit(main())
